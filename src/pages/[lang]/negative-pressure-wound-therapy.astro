---
import TopicPage from '../../components/TopicPage.astro';
import data from '../../content/pages/npwt';
import { langs } from '../../lib/routes';
import type { Lang } from '../../config/site';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
---
<TopicPage lang={Astro.params.lang as Lang} pageKey="npwt" data={data} topicName={{ ar: 'العلاج بالضغط السلبي للجروح', en: 'Negative pressure wound therapy' }} />
