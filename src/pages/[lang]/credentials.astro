---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { person, credentials, nursingLicence, type Lang } from '../../config/site';
import { path, langs } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { formatDate } from '../../lib/i18n';
import { track } from '../../lib/links';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const updated = '2026-10-05';
const cws = credentials.find((c) => c.id === 'cws')!;

const copy = {
  ar: {
    title: 'مؤهلات آيسر شواقفة | اعتماد CWS® والترخيص التمريضي',
    description: 'المؤهلات والاعتمادات المهنية لآيسر شواقفة: اعتماد Certified Wound Specialist (CWS®) من ABWM، والترخيص التمريضي في الأردن، وبكالوريوس التمريض، مع طرق التحقق.',
    h1: 'المؤهلات والاعتمادات المهنية لآيسر شواقفة',
    lead: 'تعرض هذه الصفحة المؤهلات التي يستند إليها لقب «ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS®»، مع الجهة المانحة وسنة الحصول عليها وطريقة التحقق المتاحة.',
    updated: 'آخر تحديث',
    tableCaption: 'المؤهلات والشهادات',
    th: ['المؤهل', 'الجهة المانحة', 'السنة', 'التحقق'],
    verifyDirectory: 'دليل ABWM الرسمي',
    onRequest: 'متاح عند الطلب',
    cwsH: 'ما هو اعتماد CWS®؟',
    cws: [
      'Certified Wound Specialist (CWS®) اعتماد تمنحه American Board of Wound Management، وهي جهة اعتماد متعددة التخصصات في مجال العناية بالجروح.',
      'يشترط للتقدم أن يكون المتقدم ممارسًا صحيًا مرخصًا، مثل الممرض القانوني أو الطبيب أو أخصائي العلاج الطبيعي، ولديه ثلاث سنوات أو أكثر من الخبرة السريرية في العناية بالجروح، ثم اجتياز اختبار الاعتماد.',
      'برنامج CWS® معتمد من National Commission for Certifying Agencies (NCCA).',
    ],
    verifyH: 'كيف تتحقق من الاعتماد',
    verify: [
      `ابحث في دليل ABWM الرسمي. صدرت الشهادة بالتهجئة الإنجليزية «${person.certificateName}».`,
      'لأغراض التوظيف أو الشراكات المهنية، يمكن تزويد الجهات المعنية بنسخة من الشهادات عند الطلب.',
    ],
    licenceH: 'الترخيص التمريضي',
    licence: `${nursingLicence.status.ar}. لا يُنشر رقم الترخيص على الموقع حفاظًا على الخصوصية، ويمكن تزويد الجهات المهنية به عند الطلب.`,
    otherH: 'تدريب مهني إضافي',
    nameH: 'تهجئة الاسم',
    nameP: `الاسم المعتمد على الموقع هو «آيسر شواقفة» (${person.name.en}). قد يظهر الاسم في بعض الوثائق والمنصات بتهجئات إنجليزية أخرى مثل Aissar Shawaqfeh، وجميعها تعود للشخص نفسه.`,
    back: 'العودة إلى النبذة',
    contact: 'طلب التحقق أو التواصل المهني',
  },
  en: {
    title: 'Ayser Shawaqfeh Credentials | CWS® and Nursing Licence',
    description: 'Professional credentials of Ayser Shawaqfeh: Certified Wound Specialist (CWS®) from ABWM, Registered Nurse licensed in Jordan and B.Sc. Nursing, with how to verify them.',
    h1: 'Credentials and professional verification of Ayser Shawaqfeh',
    lead: 'This page lists the qualifications behind the title “Registered Nurse and Certified Wound Specialist, CWS®”, with the issuing body, the year and the available way to verify each one.',
    updated: 'Last updated',
    tableCaption: 'Qualifications and certificates',
    th: ['Qualification', 'Issued by', 'Year', 'Verification'],
    verifyDirectory: 'Official ABWM directory',
    onRequest: 'Available on request',
    cwsH: 'What is the CWS® credential?',
    cws: [
      'Certified Wound Specialist (CWS®) is awarded by the American Board of Wound Management, a multidisciplinary certification board for wound care.',
      'To apply, a candidate must be a licensed healthcare professional, such as a registered nurse, physician or physical therapist, with three or more years of clinical wound care experience, and must then pass the certification exam.',
      'The CWS® program is accredited by the National Commission for Certifying Agencies (NCCA).',
    ],
    verifyH: 'How to verify the credential',
    verify: [
      `Search the official ABWM directory. The certificate was issued under the spelling “${person.certificateName}”.`,
      'For employment or professional partnerships, copies of certificates can be provided on request.',
    ],
    licenceH: 'Nursing licence',
    licence: `${nursingLicence.status.en}. The licence number is not published on this website for privacy and can be shared with professional bodies on request.`,
    otherH: 'Additional professional training',
    nameH: 'Name spelling',
    nameP: `The name used on this website is “${person.name.en}” (آيسر شواقفة). Some documents and platforms show other English spellings, such as Aissar Shawaqfeh; they all refer to the same person.`,
    back: 'Back to the profile',
    contact: 'Request verification or professional contact',
  },
}[lang];

const schema = pageGraph({ lang, key: 'credentials', type: 'AboutPage', title: copy.title, description: copy.description, dateModified: updated, mainEntityPerson: true });
---
<BaseLayout lang={lang} pageKey="credentials" title={copy.title} description={copy.description} schema={schema}>
  <div class="wrap">
    <Breadcrumbs lang={lang} pageKey="credentials" />
    <header class="page-head prose">
      <h1>{copy.h1}</h1>
      <p class="page-dates">{copy.updated}: <time datetime={updated}>{formatDate(updated, lang)}</time></p>
      <p class="lead">{copy.lead}</p>
    </header>

    <table class="data stack">
      <caption>{copy.tableCaption}</caption>
      <thead><tr>{copy.th.map((h) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>
        {credentials.filter((c) => c.clinical).map((c) => (
          <tr>
            <td data-label={copy.th[0]}><strong>{c.name[lang]}</strong></td>
            <td data-label={copy.th[1]}>{c.issuer ? c.issuer[lang] : ''}</td>
            <td data-label={copy.th[2]}>{c.year}</td>
            <td data-label={copy.th[3]}>{c.verifyUrl ? <a href={c.verifyUrl} rel="noopener">{copy.verifyDirectory}</a> : copy.onRequest}</td>
          </tr>
        ))}
        <tr>
          <td data-label={copy.th[0]}><strong>{nursingLicence.status[lang]}</strong></td>
          <td data-label={copy.th[1]}>{nursingLicence.body[lang]}</td>
          <td data-label={copy.th[2]}>—</td>
          <td data-label={copy.th[3]}>{copy.onRequest}</td>
        </tr>
      </tbody>
    </table>

    <div class="grid-2">
      <section class="prose" aria-labelledby="cws-h">
        <h2 id="cws-h" class="flush">{copy.cwsH}</h2>
        {copy.cws.map((p) => <p>{p}</p>)}
        <p lang="en" dir="ltr"><a href="https://abwmcertified.org/abwm-cws/" rel="noopener">ABWM — Certified Wound Specialist</a></p>
      </section>
      <section class="prose" aria-labelledby="verify-h">
        <h2 id="verify-h" class="flush">{copy.verifyH}</h2>
        {copy.verify.map((p, i) => <p>{i === 0 ? <>{p} <a href={cws.verifyUrl} rel="noopener">{copy.verifyDirectory}</a></> : p}</p>)}
        <h3>{copy.licenceH}</h3>
        <p>{copy.licence}</p>
      </section>
    </div>

    <section class="prose" aria-labelledby="other-h">
      <h2 id="other-h">{copy.otherH}</h2>
      <ul>
        {credentials.filter((c) => !c.clinical).map((c) => (
          <li><strong>{c.name[lang]}</strong>{c.issuer ? ` — ${c.issuer[lang]}` : ''} ({c.year})</li>
        ))}
      </ul>
      <h3>{copy.nameH}</h3>
      <p>{copy.nameP}</p>
      <div class="actions">
        <a class="btn btn-primary" href={path(lang, 'contact')} {...track('cta_click', { lang, page: 'credentials', placement: 'verify-contact' })}>{copy.contact}</a>
        <a class="btn btn-secondary" href={path(lang, 'about')}>{copy.back}</a>
      </div>
    </section>
  </div>
</BaseLayout>
