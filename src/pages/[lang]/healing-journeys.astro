---
/**
 * Public page for the private "healing journeys" gallery (cases.speranzahealth.net).
 * No patient images here: it explains the gallery, the access rules and how to request a personal code.
 * GALLERY_OPEN switches the status from "being prepared" to open (and shows the gallery link).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { type Lang } from '../../config/site';
import { langs } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { t } from '../../lib/i18n';
import { whatsappUrl, track } from '../../lib/links';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const GALLERY_OPEN = false;
const GALLERY_URL = 'https://cases.speranzahealth.net';
/** Requests are handled by the gallery app (cases.speranzahealth.net) and appear in its admin under «الطلبات». */
const REQUEST_URL = `${GALLERY_URL}/request?lang=${Astro.params.lang}`;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const ref = { lang, page: 'journeys', placement: 'request' };

const copy = {
  ar: {
    title: 'معرض رحلات الالتئام: حالات موثّقة بموافقة أصحابها | سبيرانزا هيلث',
    description: 'معرض خاص يعرض مراحل التئام جروح مختلفة بالصور، بموافقة خطية من أصحابها وبعد إخفاء هويتهم. الدخول برابط ورمز شخصيين من فريق سبيرانزا هيلث.',
    status: GALLERY_OPEN ? 'متاح بالرمز' : 'قيد الإنشاء',
    h1: 'معرض رحلات الالتئام',
    lead: 'حالات حقيقية موثّقة بالصور لمراحل التئام جروح مختلفة، من البداية حتى آخر مرحلة، مع شرح مبسّط لما تغيّر في كل مرحلة. الهدف أن ترى جودة العناية المقدّمة، وأن تستفيد توعويًا من رحلات حقيقية.',
    privateH: 'لماذا المعرض خاص؟',
    privateP: 'صور الجروح بيانات صحية حساسة. لذلك لا يُنشر المعرض للعامة ولا يظهر في محركات البحث، والدخول إليه برابط ورمز شخصيين فقط.',
    stepsH: 'كيف تحصل على الدخول؟',
    steps: [
      ['اطلب الدخول', 'املأ نموذج الطلب في هذه الصفحة، أو تواصل مع فريق سبيرانزا عبر واتساب.'],
      ['استلم رابطك ورمزك', 'يصلك رابط شخصي ورمز من 5 أرقام، صالحان لمدة 7 أيام.'],
      ['وافق على الشروط وادخل', 'افتح الرابط، واقرأ شروط الدخول ووافق عليها، ثم أدخل الرمز.'],
    ],
    commitH: 'التزاماتنا تجاه المرضى',
    commit: [
      'لا تُنشر أي حالة إلا بموافقة خطية موقّعة من صاحبها، ويحق له سحبها في أي وقت.',
      'تُخفى كل علامات الهوية: لا وجوه ولا أسماء ولا وشوم ولا تواريخ.',
      'تُحذف البيانات المخفية في الصور (مثل الموقع والتاريخ ونوع الجهاز) تلقائيًا عند الرفع.',
      'تُحفظ الصور في تخزين خاص غير متاح للعامة.',
    ],
    termsH: 'شروط المشاهدة',
    terms: [
      'المعرض للتثقيف الصحي وللاطلاع على جودة العناية، ولا يقدّم تشخيصًا أو نصيحة طبية فردية.',
      'الرابط والرمز شخصيان، ولا يجوز مشاركتهما مع أي شخص آخر.',
      'يُمنع تصوير الشاشة أو حفظ أو نشر أي صورة أو فيديو من المعرض.',
      'كل صورة تحمل علامة مائية مرتبطة برمز المشاهد، ويُسجَّل الدخول.',
      'النتائج تختلف من حالة لأخرى.',
    ],
    requestMsg: 'مرحبًا، أرغب بطلب رمز دخول لمعرض رحلات الالتئام في سبيرانزا هيلث.',
    request: 'أو اطلب الرمز عبر واتساب',
    open: 'الدخول إلى المعرض',
    requestCta: 'اطلب رمز الدخول',
    formH: 'طلب رمز دخول المعرض',
    formP: 'املأ الطلب، وسيراجعه فريق سبيرانزا ويرسل لك رابطًا شخصيًا ورمزًا عبر واتساب. لا تكتب أي معلومات صحية.',
    fName: 'الاسم',
    fPhone: 'رقم الواتساب',
    fPhoneHint: 'مثال: 0791234567',
    fRole: 'صفتك',
    roles: [['patient', 'مريض'], ['family', 'أحد أفراد أسرة مريض'], ['professional', 'كادر صحي'], ['other', 'أخرى']],
    fTerms: 'قرأت شروط المشاهدة وأوافق عليها، وأوافق على استخدام اسمي ورقمي فقط لإرسال الرمز.',
    fSend: 'إرسال الطلب',
    fPrivacy: 'تُحذف بيانات الطلب بعد معالجته، أو خلال 30 يومًا كحد أقصى.',
    soonNote: 'نعمل حاليًا على تجهيز الحالات الأولى وتوثيقها. يمكنك طلب الرمز الآن، وسنرسله لك عند افتتاح المعرض.',
  },
  en: {
    title: 'Healing Journeys Gallery | Speranza Health',
    description: 'A private gallery showing the healing stages of different wounds in photos, with written patient consent and identities removed. Access by a personal link and code.',
    status: GALLERY_OPEN ? 'Open with a code' : 'Being prepared',
    h1: 'Healing journeys gallery',
    lead: 'Real, photo-documented healing stages of different wounds, from the start to the latest stage, with a short explanation of what changed at each step. It shows the quality of care provided and offers practical health education from real journeys.',
    privateH: 'Why is the gallery private?',
    privateP: 'Wound photos are sensitive health data. The gallery is therefore not public and is hidden from search engines; access is by a personal link and code only.',
    stepsH: 'How do I get access?',
    steps: [
      ['Request access', 'Fill in the request form on this page, or message the Speranza team on WhatsApp.'],
      ['Receive your link and code', 'You get a personal link and a 5-digit code, valid for 7 days.'],
      ['Accept the terms and enter', 'Open the link, read and accept the terms of access, then enter the code.'],
    ],
    commitH: 'Our commitments to patients',
    commit: [
      'No case is published without the patient’s signed written consent, which can be withdrawn at any time.',
      'Everything identifying is removed: no faces, names, tattoos or dates.',
      'Hidden photo data (such as location, date and device) is removed automatically on upload.',
      'Images are kept in private storage that is not publicly accessible.',
    ],
    termsH: 'Terms of viewing',
    terms: [
      'The gallery is for health education and to show the quality of care. It does not provide diagnosis or individual medical advice.',
      'The link and code are personal and must not be shared with anyone else.',
      'Screenshots, saving or publishing any image or video from the gallery are not permitted.',
      'Every image carries a watermark linked to the viewer’s code, and access is logged.',
      'Results vary from case to case.',
    ],
    requestMsg: 'Hello, I would like to request an access code for the Speranza Health healing journeys gallery.',
    request: 'Or request the code on WhatsApp',
    open: 'Go to the gallery',
    requestCta: 'Request an access code',
    formH: 'Request gallery access',
    formP: 'Fill in the request and the Speranza team will review it and send you a personal link and code on WhatsApp. Please don’t include any health information.',
    fName: 'Name',
    fPhone: 'WhatsApp number',
    fPhoneHint: 'e.g. 0791234567 or +962791234567',
    fRole: 'You are',
    roles: [['patient', 'A patient'], ['family', 'A family member of a patient'], ['professional', 'A healthcare professional'], ['other', 'Other']],
    fTerms: 'I have read and accept the terms of viewing, and agree that my name and number are used only to send the code.',
    fSend: 'Send request',
    fPrivacy: 'Request details are deleted once handled, or within 30 days at the latest.',
    soonNote: 'We are preparing and documenting the first cases. You can request a code now and we will send it when the gallery opens.',
  },
}[lang];

const schema = pageGraph({ lang, key: 'journeys', type: 'WebPage', title: copy.title, description: copy.description, dateModified: '2026-10-15' });
---
<BaseLayout lang={lang} pageKey="journeys" title={copy.title} description={copy.description} schema={schema}>
  <div class="wrap">
    <Breadcrumbs lang={lang} pageKey="journeys" />
    <header class="page-head prose">
      <p class="brand-eyebrow"><span class={GALLERY_OPEN ? 'hj-dot open' : 'hj-dot'} aria-hidden="true"></span>{copy.status}</p>
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      {!GALLERY_OPEN && <p class="soon-note">{copy.soonNote}</p>}
      <div class="actions">
        <a class="btn btn-primary" href="#request" {...track('cta_click', { ...ref, placement: 'hero-request' })}>{copy.requestCta}</a>
        {GALLERY_OPEN && <a class="btn btn-secondary" href={GALLERY_URL} rel="noopener">{copy.open}</a>}
      </div>
    </header>

    <section class="hj-steps" aria-labelledby="steps-h">
      <h2 id="steps-h">{copy.stepsH}</h2>
      <ol class="purpose-list" role="list">
        {copy.steps.map(([h, p], i) => (
          <li><span class="pl-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>
        ))}
      </ol>
    </section>

    <section id="request" class="hj-request" aria-labelledby="form-h">
      <div class="prose">
        <h2 id="form-h" class="flush">{copy.formH}</h2>
        <p>{copy.formP}</p>
      </div>
      <form class="form" method="post" action={REQUEST_URL}>
        <div class="field">
          <label for="r-name">{copy.fName}</label>
          <input type="text" id="r-name" name="name" autocomplete="given-name" maxlength="60" required />
        </div>
        <div class="field">
          <label for="r-phone">{copy.fPhone}</label>
          <input type="tel" id="r-phone" name="phone" autocomplete="tel" inputmode="tel" dir="ltr" maxlength="20" placeholder={copy.fPhoneHint} required />
        </div>
        <div class="field">
          <fieldset>
            <legend>{copy.fRole}</legend>
            {copy.roles.map(([v, l]) => (
              <div class="choice"><input type="radio" id={`r-role-${v}`} name="role" value={v} required /><label for={`r-role-${v}`}>{l}</label></div>
            ))}
          </fieldset>
        </div>
        <div class="field">
          <div class="choice" style="align-items:flex-start">
            <input type="checkbox" id="r-accept" name="accept" value="1" required style="margin-top:0.3rem" />
            <label for="r-accept">{copy.fTerms} <a href="#terms-h">{copy.termsH}</a></label>
          </div>
        </div>
        <div class="hj-hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button type="submit" class="btn btn-primary">{copy.fSend}</button>
        <p class="hint">{copy.fPrivacy}</p>
        <p class="hint"><a href={whatsappUrl(ref, copy.requestMsg)} rel="noopener" {...track('whatsapp_click', ref)}>{copy.request}</a></p>
      </form>
    </section>

    <div class="grid-2 section-gap">
      <section class="prose" aria-labelledby="private-h">
        <h2 id="private-h" class="flush">{copy.privateH}</h2>
        <p>{copy.privateP}</p>
        <h2>{copy.commitH}</h2>
        <ul class="dc-uses" role="list">{copy.commit.map((c) => <li><Icon name="check" /><span>{c}</span></li>)}</ul>
      </section>
      <section class="callout prose" aria-labelledby="terms-h">
        <h2 id="terms-h" class="flush">{copy.termsH}</h2>
        <ol>{copy.terms.map((c) => <li>{c}</li>)}</ol>
        <p><strong>{s.emergencyShort}</strong></p>
      </section>
    </div>
  </div>
</BaseLayout>
