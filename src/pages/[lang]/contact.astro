---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactActions from '../../components/ContactActions.astro';
import { contact, flags, type Lang } from '../../config/site';
import { path, langs } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);

const cities = {
  ar: ['عمّان', 'إربد', 'الزرقاء', 'البلقاء', 'مأدبا', 'جرش', 'عجلون', 'المفرق', 'الكرك', 'الطفيلة', 'معان', 'العقبة', 'خارج الأردن'],
  en: ['Amman', 'Irbid', 'Zarqa', 'Balqa', 'Madaba', 'Jerash', 'Ajloun', 'Mafraq', 'Karak', 'Tafilah', 'Ma’an', 'Aqaba', 'Outside Jordan'],
}[lang];

// Reasons offered. Patient-assessment coordination appears only once a licensed pathway is confirmed.
const reasons = [
  { v: 'professional', ar: 'استفسار مهني', en: 'Professional enquiry' },
  { v: 'education', ar: 'التدريب والتعليم في العناية بالجروح', en: 'Wound-care education and training' },
  { v: 'collaboration', ar: 'تعاون مهني أو محاضرة أو مقابلة', en: 'Collaboration, talk or interview' },
  ...(flags.patientServicesConfirmed ? [{ v: 'assessment', ar: 'تنسيق تقييم أو إحالة', en: 'Coordinate an assessment or referral' }] : []),
  { v: 'other', ar: 'سبب آخر', en: 'Something else' },
];

const copy = {
  ar: {
    title: 'التواصل مع أيسر شواقفه | استفسارات مهنية وتدريب',
    description: 'تواصل مع أيسر شواقفه، ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS® في عمّان، للاستفسارات المهنية والتدريب والتعاون عبر WhatsApp أو الهاتف أو البريد الإلكتروني.',
    h1: 'التواصل مع أيسر شواقفه',
    lead: 'للاستفسارات المهنية، والتدريب في العناية بالجروح، والتعاون مع المنشآت والجهات التعليمية.',
    direct: 'تواصل مباشر',
    formH: 'أرسل استفسارًا قصيرًا',
    formIntro: 'لا يحفظ الموقع أي بيانات. عند الإرسال تُفتح رسالة جاهزة في WhatsApp أو البريد الإلكتروني لتراجعها قبل إرسالها.',
    privacyWarn: 'لا ترسل صور الجروح أو التقارير الطبية أو تفاصيل التشخيص عبر هذا النموذج أو الرسائل.',
    firstName: 'الاسم الأول', firstNameHint: 'الاسم الأول فقط',
    city: 'المدينة', cityPlaceholder: 'اختر المدينة',
    reason: 'سبب التواصل', reasonPlaceholder: 'اختر السبب',
    method: 'طريقة التواصل المفضلة',
    methods: { whatsapp: 'WhatsApp', phone: 'مكالمة هاتفية', email: 'البريد الإلكتروني' },
    consent: 'أوافق على أن يتواصل معي أيسر شواقفه بخصوص هذا الاستفسار، وقد قرأت سياسة الخصوصية.',
    submit: 'تجهيز الرسالة',
    errors: {
      firstName: 'اكتب اسمك الأول (حرفان على الأقل، دون أرقام).',
      city: 'اختر المدينة.',
      reason: 'اختر سبب التواصل.',
      method: 'اختر طريقة التواصل المفضلة.',
      consent: 'يلزم الموافقة على التواصل لإرسال الاستفسار.',
      summary: 'يرجى تصحيح الحقول المشار إليها.',
    },
    ok: 'تم تجهيز رسالتك. راجعها في التطبيق الذي فُتح ثم اضغط إرسال.',
    msg: { hello: 'مرحبًا، أرسل استفسارًا من الموقع.', name: 'الاسم', city: 'المدينة', reason: 'السبب', method: 'طريقة التواصل المفضلة' },
    hours: 'ساعات الرد',
    areas: 'المناطق',
    emergencyH: 'الحالات الطارئة',
  },
  en: {
    title: 'Contact Aissar Shawaqfeh | Professional Enquiries and Training',
    description: 'Contact Aissar Shawaqfeh, Registered Nurse and Certified Wound Specialist in Amman, about professional enquiries, training and collaboration.',
    h1: 'Contact Aissar Shawaqfeh',
    lead: 'For professional enquiries, wound-care education and training, and collaboration with healthcare facilities and educators.',
    direct: 'Direct contact',
    formH: 'Send a short enquiry',
    formIntro: 'This website stores no data. When you send, a ready-made message opens in WhatsApp or your email app so you can review it before sending.',
    privacyWarn: 'Please don’t send wound photos, medical reports or diagnosis details through this form or by message.',
    firstName: 'First name', firstNameHint: 'First name only',
    city: 'City', cityPlaceholder: 'Choose a city',
    reason: 'Reason for contacting', reasonPlaceholder: 'Choose a reason',
    method: 'Preferred contact method',
    methods: { whatsapp: 'WhatsApp', phone: 'Phone call', email: 'Email' },
    consent: 'I agree to be contacted by Aissar Shawaqfeh about this enquiry, and I have read the privacy policy.',
    submit: 'Prepare my message',
    errors: {
      firstName: 'Enter your first name (at least 2 letters, no numbers).',
      city: 'Choose your city.',
      reason: 'Choose a reason for contacting.',
      method: 'Choose how you would like to be contacted.',
      consent: 'Consent to be contacted is required to send an enquiry.',
      summary: 'Please correct the highlighted fields.',
    },
    ok: 'Your message is ready. Review it in the app that opened, then press send.',
    msg: { hello: 'Hello, I am sending an enquiry from the website.', name: 'Name', city: 'City', reason: 'Reason', method: 'Preferred contact' },
    hours: 'Response hours',
    areas: 'Areas',
    emergencyH: 'Emergencies',
  },
}[lang];

const schema = pageGraph({ lang, key: 'contact', type: 'ContactPage', title: copy.title, description: copy.description, dateModified: '2026-10-05' });
const formConfig = {
  lang, wa: contact.whatsappE164, email: contact.email,
  errors: copy.errors, ok: copy.ok, msg: copy.msg, methods: copy.methods,
  reasons: Object.fromEntries(reasons.map((r) => [r.v, r[lang]])),
};
---
<BaseLayout lang={lang} pageKey="contact" title={copy.title} description={copy.description} schema={schema}>
  <div class="wrap">
    <Breadcrumbs lang={lang} pageKey="contact" />
    <header class="page-head prose">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </header>

    <div class="callout callout-warn prose" role="note">
      <p><strong>{copy.emergencyH}:</strong> {s.emergency}</p>
    </div>

    <div class="grid-2">
      <section aria-labelledby="direct-h">
        <h2 id="direct-h" class="flush">{copy.direct}</h2>
        <ContactActions lang={lang} page="contact" placement="direct" />
        <p><span class="ltr">{contact.phoneDisplay}</span><br /><span class="ltr">{contact.email}</span></p>
        {contact.hours && <p><strong>{copy.hours}:</strong> {contact.hours[lang]}</p>}
        <p class="prose">{copy.privacyWarn}</p>
      </section>

      <section aria-labelledby="form-h">
        <h2 id="form-h" class="flush">{copy.formH}</h2>
        <form class="form js-only" id="enquiry" novalidate>
          <p class="hint" style="margin-top:0">{copy.formIntro}</p>
          <div id="form-summary" class="error" role="alert" tabindex="-1"></div>

          <div class="field">
            <label for="f-name">{copy.firstName}</label>
            <span class="hint" id="f-name-hint">{copy.firstNameHint}</span>
            <input type="text" id="f-name" name="firstName" autocomplete="given-name" maxlength="40" required aria-describedby="f-name-hint f-name-err" />
            <p class="error" id="f-name-err"></p>
          </div>

          <div class="field">
            <label for="f-city">{copy.city}</label>
            <select id="f-city" name="city" required aria-describedby="f-city-err">
              <option value="">{copy.cityPlaceholder}</option>
              {cities.map((c) => <option value={c}>{c}</option>)}
            </select>
            <p class="error" id="f-city-err"></p>
          </div>

          <div class="field">
            <label for="f-reason">{copy.reason}</label>
            <select id="f-reason" name="reason" required aria-describedby="f-reason-err">
              <option value="">{copy.reasonPlaceholder}</option>
              {reasons.map((r) => <option value={r.v}>{r[lang]}</option>)}
            </select>
            <p class="error" id="f-reason-err"></p>
          </div>

          <div class="field">
            <fieldset aria-describedby="f-method-err">
              <legend>{copy.method}</legend>
              {(['whatsapp', 'phone', 'email'] as const).map((m) => (
                <div class="choice"><input type="radio" id={`f-m-${m}`} name="method" value={m} required /><label for={`f-m-${m}`}>{copy.methods[m]}</label></div>
              ))}
            </fieldset>
            <p class="error" id="f-method-err"></p>
          </div>

          <div class="field">
            <div class="choice" style="align-items:flex-start">
              <input type="checkbox" id="f-consent" name="consent" required aria-describedby="f-consent-err" style="margin-top:0.3rem" />
              <label for="f-consent">{copy.consent} <a href={path(lang, 'privacy')}>{s.privacyLink}</a></label>
            </div>
            <p class="error" id="f-consent-err"></p>
          </div>

          <button type="submit" class="btn btn-primary">{copy.submit}</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ cfg: formConfig }}>
  (function () {
    var form = document.getElementById('enquiry');
    if (!form) return;
    var params = new URLSearchParams(location.search);
    var pre = params.get('reason');
    if (pre && cfg.reasons[pre]) form.reason.value = pre;

    var nameRe = /^[\p{L}][\p{L}\p{M}' \-]{1,39}$/u;
    function setErr(id, field, msg) {
      document.getElementById(id).textContent = msg || '';
      if (field) field.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = form.firstName.value.trim();
      var method = (form.querySelector('input[name="method"]:checked') || {}).value;
      var ok = [
        setErr('f-name-err', form.firstName, nameRe.test(name) ? '' : cfg.errors.firstName),
        setErr('f-city-err', form.city, form.city.value ? '' : cfg.errors.city),
        setErr('f-reason-err', form.reason, form.reason.value ? '' : cfg.errors.reason),
        setErr('f-method-err', null, method ? '' : cfg.errors.method),
        setErr('f-consent-err', form.consent, form.consent.checked ? '' : cfg.errors.consent),
      ].every(Boolean);
      var summary = document.getElementById('form-summary');
      if (!ok) {
        summary.textContent = cfg.errors.summary;
        var first = form.querySelector('[aria-invalid="true"]') || form.querySelector('input[name="method"]');
        if (first) first.focus();
        return;
      }
      summary.textContent = '';
      var ref = cfg.lang + '-contact-form';
      var lines = [
        cfg.msg.hello,
        cfg.msg.name + ': ' + name,
        cfg.msg.city + ': ' + form.city.value,
        cfg.msg.reason + ': ' + cfg.reasons[form.reason.value],
        cfg.msg.method + ': ' + cfg.methods[method],
        '(ref: ' + ref + ')',
      ];
      var text = lines.join('\n');
      var url = method === 'email'
        ? 'mailto:' + cfg.email + '?subject=' + encodeURIComponent(cfg.reasons[form.reason.value] + ' [' + ref + ']') + '&body=' + encodeURIComponent(text)
        : 'https://wa.me/' + cfg.wa + '?text=' + encodeURIComponent(text);
      if (window.siteTrack) window.siteTrack('generate_lead', { reason: form.reason.value, method: method, ref: ref });
      document.getElementById('form-status').textContent = cfg.ok;
      if (method === 'email') location.href = url; else window.open(url, '_blank', 'noopener');
    });
  })();
</script>
