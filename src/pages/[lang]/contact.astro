---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactActions from '../../components/ContactActions.astro';
import { contact, type Lang } from '../../config/site';
import { path, langs } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);

const copy = {
  ar: {
    title: 'التواصل مع أيسر شواقفه | العناية بالجروح في الأردن',
    description: 'تواصل مع أيسر شواقفه، ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS® في الأردن، عبر WhatsApp أو الهاتف أو البريد الإلكتروني.',
    h1: 'التواصل',
    lead: 'للاستفسارات والتدريب والتعاون من جميع أنحاء الأردن.',
    direct: 'تواصل مباشر',
    formH: 'أرسل رسالة قصيرة',
    formIntro: 'لا يحفظ الموقع أي بيانات. عند الإرسال تُفتح رسالة جاهزة في WhatsApp أو البريد الإلكتروني لتراجعها قبل إرسالها.',
    privacyWarn: 'لا ترسل صور الجروح أو التقارير الطبية أو تفاصيل التشخيص عبر الرسائل قبل الاتفاق على طريقة آمنة.',
    firstName: 'الاسم الأول',
    method: 'طريقة التواصل المفضلة',
    methods: { whatsapp: 'WhatsApp', phone: 'مكالمة هاتفية', email: 'البريد الإلكتروني' },
    consent: 'أوافق على أن يتم التواصل معي بخصوص رسالتي، وقد قرأت',
    submit: 'إرسال',
    errors: {
      firstName: 'اكتب اسمك الأول (حرفان على الأقل، دون أرقام).',
      method: 'اختر طريقة التواصل المفضلة.',
      consent: 'يلزم الموافقة على التواصل لإرسال الرسالة.',
      summary: 'يرجى تصحيح الحقول المشار إليها.',
    },
    ok: 'تم تجهيز رسالتك. راجعها في التطبيق الذي فُتح ثم اضغط إرسال.',
    msg: { hello: 'مرحبًا، أتواصل معك من الموقع.', name: 'الاسم', method: 'طريقة التواصل المفضلة', topic: 'الموضوع: التدريب والتعليم' },
    hours: 'ساعات الرد',
    emergencyH: 'الحالات الطارئة',
  },
  en: {
    title: 'Contact Aissar Shawaqfeh | Wound Care in Jordan',
    description: 'Contact Aissar Shawaqfeh, Registered Nurse and Certified Wound Specialist (CWS®) in Jordan, by WhatsApp, phone or email.',
    h1: 'Contact',
    lead: 'For enquiries, training and collaboration from anywhere in Jordan.',
    direct: 'Direct contact',
    formH: 'Send a short message',
    formIntro: 'This website stores no data. When you send, a ready-made message opens in WhatsApp or your email app so you can review it first.',
    privacyWarn: 'Please don’t send wound photos, medical reports or diagnosis details by message until a secure method has been agreed.',
    firstName: 'First name',
    method: 'Preferred contact method',
    methods: { whatsapp: 'WhatsApp', phone: 'Phone call', email: 'Email' },
    consent: 'I agree to be contacted about my message, and I have read the',
    submit: 'Send',
    errors: {
      firstName: 'Enter your first name (at least 2 letters, no numbers).',
      method: 'Choose how you would like to be contacted.',
      consent: 'Consent to be contacted is required to send a message.',
      summary: 'Please correct the highlighted fields.',
    },
    ok: 'Your message is ready. Review it in the app that opened, then press send.',
    msg: { hello: 'Hello, I am contacting you from the website.', name: 'Name', method: 'Preferred contact', topic: 'Topic: education and training' },
    hours: 'Response hours',
    emergencyH: 'Emergencies',
  },
}[lang];

const schema = pageGraph({ lang, key: 'contact', type: 'ContactPage', title: copy.title, description: copy.description, dateModified: '2026-10-06' });
const formConfig = { lang, wa: contact.whatsappE164, email: contact.email, errors: copy.errors, ok: copy.ok, msg: copy.msg, methods: copy.methods };
---
<BaseLayout lang={lang} pageKey="contact" title={copy.title} description={copy.description} schema={schema}>
  <div class="wrap">
    <Breadcrumbs lang={lang} pageKey="contact" />
    <header class="page-head prose">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </header>

    <div class="callout callout-warn prose" role="note">
      <p><strong>{copy.emergencyH}:</strong> {s.emergency}</p>
    </div>

    <div class="grid-2">
      <section aria-labelledby="direct-h">
        <h2 id="direct-h" class="flush">{copy.direct}</h2>
        <ContactActions lang={lang} page="contact" placement="direct" />
        <p><span class="ltr">{contact.phoneDisplay}</span><br /><span class="ltr">{contact.email}</span></p>
        {contact.hours && <p><strong>{copy.hours}:</strong> {contact.hours[lang]}</p>}
        <p class="prose">{copy.privacyWarn}</p>
      </section>

      <section aria-labelledby="form-h">
        <h2 id="form-h" class="flush">{copy.formH}</h2>
        <form class="form js-only" id="enquiry" novalidate>
          <p class="hint" style="margin-top:0">{copy.formIntro}</p>
          <div id="form-summary" class="error" role="alert" tabindex="-1"></div>

          <div class="field">
            <label for="f-name">{copy.firstName}</label>
            <input type="text" id="f-name" name="firstName" autocomplete="given-name" maxlength="40" required aria-describedby="f-name-err" />
            <p class="error" id="f-name-err"></p>
          </div>

          <div class="field">
            <fieldset aria-describedby="f-method-err">
              <legend>{copy.method}</legend>
              {(['whatsapp', 'phone', 'email'] as const).map((m) => (
                <div class="choice"><input type="radio" id={`f-m-${m}`} name="method" value={m} required /><label for={`f-m-${m}`}>{copy.methods[m]}</label></div>
              ))}
            </fieldset>
            <p class="error" id="f-method-err"></p>
          </div>

          <div class="field">
            <div class="choice" style="align-items:flex-start">
              <input type="checkbox" id="f-consent" name="consent" required aria-describedby="f-consent-err" style="margin-top:0.3rem" />
              <label for="f-consent">{copy.consent} <a href={path(lang, 'legal')}>{s.privacyLink}</a></label>
            </div>
            <p class="error" id="f-consent-err"></p>
          </div>

          <button type="submit" class="btn btn-primary">{copy.submit}</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ cfg: formConfig }}>
  (function () {
    var form = document.getElementById('enquiry');
    if (!form) return;
    var topic = new URLSearchParams(location.search).get('reason') === 'education' ? cfg.msg.topic : '';
    var nameRe = /^[\p{L}][\p{L}\p{M}' \-]{1,39}$/u;
    function setErr(id, field, msg) {
      document.getElementById(id).textContent = msg || '';
      if (field) field.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = form.firstName.value.trim();
      var method = (form.querySelector('input[name="method"]:checked') || {}).value;
      var ok = [
        setErr('f-name-err', form.firstName, nameRe.test(name) ? '' : cfg.errors.firstName),
        setErr('f-method-err', null, method ? '' : cfg.errors.method),
        setErr('f-consent-err', form.consent, form.consent.checked ? '' : cfg.errors.consent),
      ].every(Boolean);
      var summary = document.getElementById('form-summary');
      if (!ok) {
        summary.textContent = cfg.errors.summary;
        var first = form.querySelector('[aria-invalid="true"]') || form.querySelector('input[name="method"]');
        if (first) first.focus();
        return;
      }
      summary.textContent = '';
      var ref = cfg.lang + '-contact-form';
      var lines = [cfg.msg.hello, cfg.msg.name + ': ' + name, cfg.msg.method + ': ' + cfg.methods[method]];
      if (topic) lines.push(topic);
      lines.push('(ref: ' + ref + ')');
      var text = lines.join('\n');
      var url = method === 'email'
        ? 'mailto:' + cfg.email + '?subject=' + encodeURIComponent(cfg.msg.hello + ' [' + ref + ']') + '&body=' + encodeURIComponent(text)
        : 'https://wa.me/' + cfg.wa + '?text=' + encodeURIComponent(text);
      if (window.siteTrack) window.siteTrack('generate_lead', { method: method, ref: ref });
      document.getElementById('form-status').textContent = cfg.ok;
      if (method === 'email') location.href = url; else window.open(url, '_blank', 'noopener');
    });
  })();
</script>
