---
/**
 * Remote consultation (Aissar, 23 Nov 2026): a profile for each specialty with its providers and their
 * hours, and online booking inside the platform. Booking → instant confirmation email to the client.
 * Data: src/config/consult.ts. Booking server: gallery app (/consult/api). Room: /…/consultation-room/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactActions from '../../components/ContactActions.astro';
import Icon from '../../components/Icon.astro';
import { type Lang } from '../../config/site';
import { consult, specialties, providers, providersFor, isBookable, days, type Provider } from '../../config/consult';
import { path, langs } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { t } from '../../lib/i18n';
import { track } from '../../lib/links';

export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const s = t(lang);
const updated = '2026-11-23';

const copy = {
  ar: {
