---
/** About + credentials (merged 6 Oct 2026). Slug comes from config (person.aboutSlug). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactActions from '../../components/ContactActions.astro';
import TeamSection from '../../components/TeamSection.astro';
import VideoSection from '../../components/VideoSection.astro';
import Portrait from '../../components/Portrait.astro';
import { person, credentials, nursingLicence, yearsExperience, type Lang } from '../../config/site';
import { path, langs, careNav, pages } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { formatDate } from '../../lib/i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang, about: person.aboutSlug } }));
}
const lang = Astro.params.lang as Lang;
const yrs = yearsExperience();
const updated = '2026-10-06';
const cws = credentials.find((c) => c.id === 'cws')!;

const copy = {
  ar: {
    title: 'أيسر شواقفه | ممرض وأخصائي جروح معتمد CWS® في الأردن',
    description: 'أيسر شواقفه، ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS® في الأردن: مجالات الخبرة، والعمل ضمن فريق متعدد التخصصات، والمؤهلات وطرق التحقق.',
    h1: 'أيسر شواقفه، ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS®',
    intro: `ممرض قانوني وأخصائي معتمد في العناية بالجروح في الأردن، بخبرة تمتد لنحو ${yrs} سنوات في القطاع الصحي تشمل العناية الحثيثة والعناية المتقدمة بالجروح والعلاج بالضغط السلبي. يركّز على الجروح التي لا تلتئم كما يُتوقع، وعلى تثقيف المرضى والأسر والكوادر الصحية بوضوح ووفق الدليل العلمي.`,
    focusH: 'مجالات الخبرة',
    scopeH: 'نطاق الممارسة',
    scope: 'أيسر ممرض قانوني وأخصائي جروح معتمد، وليس طبيبًا. يقدّم التقييم التمريضي والعناية بالجرح والتثقيف، بينما يبقى التشخيص ووصف الأدوية والقرارات الجراحية من مسؤولية الطبيب ضمن الفريق متعدد التخصصات.',
    credH: 'المؤهلات والتحقق',
    th: ['المؤهل', 'الجهة المانحة', 'السنة'],
    cwsP: 'اعتماد CWS® تمنحه American Board of Wound Management للممارسين الصحيين المرخصين ذوي الخبرة السريرية المثبتة في العناية بالجروح (ثلاث سنوات على الأقل) بعد اجتياز اختبار مستقل، والبرنامج معتمد من NCCA.',
    verify: `يمكن التحقق من الاعتماد في دليل ABWM الرسمي، حيث صدرت الشهادة بتهجئة «${person.certificateName}». قد يظهر الاسم في بعض المنصات بتهجئات أخرى مثل Ayser Shawaqfeh، وجميعها تعود للشخص نفسه.`,
    verifyLink: 'دليل ABWM الرسمي',
    licenceNote: 'لا يُنشر رقم الترخيص على الموقع، ويمكن تزويد الجهات المهنية به عند الطلب.',
    contactH: 'التواصل',
    updated: 'آخر تحديث',
  },
  en: {
    title: 'Aissar Shawaqfeh, RN, CWS® | Wound Care Specialist in Jordan',
    description: 'Aissar Shawaqfeh, Registered Nurse and Certified Wound Specialist (CWS®) in Jordan: areas of experience, multidisciplinary teamwork, credentials and how to verify them.',
    h1: 'Aissar Shawaqfeh, Registered Nurse and Certified Wound Specialist, CWS®',
    intro: `A Registered Nurse and Certified Wound Specialist in Jordan, with about ${yrs} years in healthcare spanning intensive care, advanced wound care and negative pressure wound therapy. His focus is wounds that are not healing as expected, and clear, evidence-based education for patients, families and healthcare teams.`,
    focusH: 'Areas of experience',
    scopeH: 'Scope of practice',
    scope: 'Aissar is a Registered Nurse and certified wound specialist, not a physician. He provides nursing assessment, wound care and education, while diagnosis, prescribing and surgical decisions remain the physician’s responsibility within the multidisciplinary team.',
    credH: 'Credentials and verification',
    th: ['Qualification', 'Issued by', 'Year'],
    cwsP: 'The CWS® credential is awarded by the American Board of Wound Management to licensed clinicians with documented clinical wound-care experience (at least three years) who pass an independent exam. The programme is NCCA-accredited.',
    verify: `The credential can be checked in the official ABWM directory, where the certificate was issued under the spelling “${person.certificateName}”. Some platforms show other spellings, such as Ayser Shawaqfeh; they all refer to the same person.`,
    verifyLink: 'Official ABWM directory',
    licenceNote: 'The licence number is not published on this website and can be shared with professional bodies on request.',
    contactH: 'Contact',
    updated: 'Last updated',
  },
}[lang];
const focusKeys = [...careNav, 'education'] as const;
const schema = pageGraph({ lang, key: 'about', type: 'ProfilePage', title: copy.title, description: copy.description, dateModified: updated, mainEntityPerson: true });
---
<BaseLayout lang={lang} pageKey="about" title={copy.title} description={copy.description} schema={schema} ogType="profile">
  <div class="wrap">
    <Breadcrumbs lang={lang} pageKey="about" />
    <header class="page-head about-head">
      <div class="prose">
        <h1>{copy.h1}</h1>
        <p class="page-dates">{copy.updated}: <time datetime={updated}>{formatDate(updated, lang)}</time></p>
        <p class="lead">{copy.intro}</p>
      </div>
      <Portrait lang={lang} />
    </header>

    <div class="grid-2">
      <section class="prose" aria-labelledby="focus-h">
        <h2 id="focus-h" class="flush">{copy.focusH}</h2>
        <ul>{focusKeys.map((k) => <li><a href={path(lang, k)}>{pages[k].nav[lang]}</a></li>)}</ul>
      </section>
      <section class="prose" aria-labelledby="scope-h">
        <h2 id="scope-h" class="flush">{copy.scopeH}</h2>
        <p>{copy.scope}</p>
      </section>
    </div>

    <div class="section-gap"><TeamSection lang={lang} /></div>

    <section id="credentials" aria-labelledby="cred-h">
      <h2 id="cred-h">{copy.credH}</h2>
      <table class="data stack">
        <thead><tr>{copy.th.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          {credentials.map((c) => (
            <tr><td data-label={copy.th[0]}><strong>{c.name[lang]}</strong></td><td data-label={copy.th[1]}>{c.issuer[lang]}</td><td data-label={copy.th[2]}>{c.year}</td></tr>
          ))}
          <tr><td data-label={copy.th[0]}><strong>{nursingLicence.status[lang]}</strong></td><td data-label={copy.th[1]}>{nursingLicence.body[lang]}</td><td data-label={copy.th[2]}>—</td></tr>
        </tbody>
      </table>
      <div class="prose">
        <p>{copy.cwsP}</p>
        <p>{copy.verify} <a href={cws.verifyUrl} rel="noopener">{copy.verifyLink}</a></p>
        <p>{copy.licenceNote}</p>
      </div>
    </section>

    <VideoSection lang={lang} page="about" />

    <section class="prose" aria-labelledby="contact-h">
      <h2 id="contact-h">{copy.contactH}</h2>
      <ContactActions lang={lang} page="about" placement="contact" />
    </section>
  </div>
</BaseLayout>
