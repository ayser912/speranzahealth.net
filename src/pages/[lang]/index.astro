---
/**
 * Homepage = Speranza Health front page (restructured 11 Oct 2026 at Aissar's request):
 * the name and its meaning, why the platform exists, and the services. Everything about Aissar
 * himself (photo, interview, figures, credentials) lives on the founder page (pages.about).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactActions from '../../components/ContactActions.astro';
import TeamSection from '../../components/TeamSection.astro';
import ArticleCards from '../../components/ArticleCards.astro';
import Icon from '../../components/Icon.astro';
import { site, person, team, flags, type Lang } from '../../config/site';
import { path, langs, careNav, pages } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { t } from '../../lib/i18n';
import { track } from '../../lib/links';
import { articles } from '../../content/articles/index';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);
const updated = '2026-10-11';

const copy = {
  ar: {
    title: 'سبيرانزا هيلث | منصة العناية بالجروح في الأردن',
    description: 'سبيرانزا هيلث: منصة رقمية أردنية للعناية بالجروح أسسها أيسر شواقفه CWS®. تثقيف موثوق وتدريب للكوادر الصحية، وقريبًا استشارة عن بعد مع فريق متعدد التخصصات.',
    eyebrow: 'Speranza · الأمل',
    h1: 'سبيرانزا هيلث',
    h1Sub: 'العناية بالجروح بالعلم والأمل، وبفريق متعدد التخصصات',
    lead: 'منصة رقمية أردنية متخصصة في العناية بالجروح: معلومة واضحة ومبنية على الدليل العلمي للمرضى والأسر، وتدريب للكوادر الصحية في جميع أنحاء الأردن، وقريبًا استشارة عن بعد بالتنسيق مع فريق طبي متعدد التخصصات.',
    ctaRemote: 'سجّل اهتمامك بالاستشارة عن بعد',
    ctaRemoteLive: 'استفسر عن الاستشارة عن بعد',
    soon: 'قريبًا',
    soonP: 'نعمل حاليًا على استكمال الفريق الطبي لهذه الخدمة، وستُنشر أسماء الأطباء وتخصصاتهم هنا عند إطلاقها. سجّل اهتمامك وسنتواصل معك عند الإطلاق.',
    remoteTeamSoon: 'التخصصات المخطط أن يضمّها الفريق:',
    ctaServices: 'تعرّف على الخدمات',
    logoAlt: 'شعار سبيرانزا هيلث: نجمة يحلّق في داخلها طائر بجناحين مفتوحين',
    meaningH: 'ماذا تعني «سبيرانزا»؟',
    meaningWord: 'Speranza',
    meaningIs: 'كلمة إيطالية تعني',
    meaningValue: 'الأمل',
    meaning: [
      'الجرح الذي لا يلتئم يُتعب المريض وأسرته، وكثيرًا ما يفقدون الأمل بعد أشهر من المراجعات وتجربة الضمادات والخلطات المختلفة.',
      'اخترنا اسم «سبيرانزا» لأن الأمل الذي نقصده ليس وعدًا بنتيجة، بل أمل مبنيّ على تقييم صحيح، ومعرفة واضحة، وفريق يعمل معًا حول المريض.',
    ],
    purposeH: 'لماذا أنشأنا سبيرانزا؟',
    purposeLead: 'لأن العناية الجيدة بالجروح في الأردن تحتاج إلى ثلاثة أشياء معًا:',
    purpose: [
      ['معلومة موثوقة بالعربية', 'محتوى تثقيفي مبني على الإرشادات الدولية يساعد المرضى والأسر على فهم الجرح، ومعرفة علامات الخطر، وتجنّب الأخطاء الشائعة.'],
      ['الطريق إلى التخصص المناسب', 'الجرح المعقد يحتاج غالبًا إلى أكثر من تخصص. ننسّق الرأي مع الفريق متعدد التخصصات بدل التنقّل بين التجارب.'],
      ['رفع مستوى الممارسة', 'تدريب وتثقيف للكوادر الصحية لنشر الممارسات الحديثة في العناية بالجروح في المستشفيات والمراكز الصحية.'],
    ],
    founderLine: 'أسّس سبيرانزا هيلث',
    founderTitle: 'ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS®',
    founderCta: 'عن المؤسس',
    servicesH: 'الخدمات المقدّمة',
    remoteTag: 'خدمة',
    remoteH: 'الاستشارة عن بعد مع الفريق الطبي متعدد التخصصات',
    remoteP: 'جلسة عن بعد (اتصال مرئي أو صوتي) لفهم وضع الجرح وتاريخه وما جُرّب من علاجات، ثم تنسيق الرأي مع التخصص المناسب من الفريق الطبي متعدد التخصصات، وتوضيح الخطوة التالية للمريض وأسرته.',
    remoteTeam: 'التخصصات التي يُنسَّق معها حسب حاجة كل حالة:',
    remoteNotes: [
      'التشخيص ووصف العلاج والقرارات الجراحية من مسؤولية الطبيب المختص ضمن الفريق.',
      'لا تُغني الاستشارة عن بعد عن الفحص السريري عندما تتطلبه الحالة.',
      'لا تُرسل صورًا أو تقارير طبية قبل الاتفاق على طريقة آمنة لمشاركتها.',
      'الحالات الطارئة لا تُدار عن بعد: توجّه إلى أقرب قسم طوارئ.',
    ],
    services: [
      { icon: 'care', h: 'إرشاد متخصص حسب نوع الجرح', p: 'معلومات وإرشاد عملي لكل نوع من الجروح، ومتى يحتاج الجرح إلى مراجعة عاجلة.', links: careNav },
      { icon: 'layers', h: 'دليل ضمادات الجروح الحديثة', p: 'الأنواع الرئيسية للضمادات الحديثة، ومكوّنات كل نوع، وما يُستخدم له عادةً، مع أداة بحث حسب حالة الجرح.', href: 'dressings', cta: 'ضمادات الجروح الحديثة' },
      { icon: 'image', h: 'معرض رحلات الالتئام', p: 'حالات حقيقية موثّقة بالصور لمراحل التئام جروح مختلفة، بموافقة أصحابها. معرض خاص يُفتح برمز شخصي.', href: 'journeys', cta: 'تعرّف على المعرض' },
      { icon: 'teach', h: 'التعليم والتدريب للكوادر الصحية', p: 'محاضرات وورش عملية للممرضين ومقدّمي الرعاية حول تقييم الجروح واختيار الضمادات والعلاج بالضغط السلبي.', href: 'education', cta: 'التعليم والتدريب' },
      { icon: 'book', h: 'تثقيف المرضى والأسر', p: 'مقالات واضحة تُراجَع بانتظام ومدعومة بمراجع علمية، تساعد الأسرة على المشاركة في العناية بثقة.', href: 'articles', cta: 'كل المقالات' },
    ],
    approachH: 'منهجنا في العمل',
    approach: [
      ['تقييم مبني على الدليل', 'قرارات العناية تستند إلى الإرشادات الدولية المعتمدة في العناية بالجروح.'],
      ['متابعة وقياس التقدم', 'قياس الجرح وتوثيقه بانتظام لمعرفة ما إذا كانت الخطة تعمل أو تحتاج إلى تعديل.'],
      ['الأسرة شريك في العناية', 'شرح واضح وعملي ومكتوب عند الحاجة، لأن الأسرة جزء أساسي من نجاح الخطة.'],
      ['وضوح في نطاق الممارسة', 'كل تخصص يعمل ضمن نطاقه، ودون وعود بنتائج علاجية مضمونة.'],
    ],
    articlesH: 'من مقالاتنا التثقيفية',
    allArticles: 'كل المقالات',
    contactH: 'التواصل',
    contactP: 'للاستفسار عن التدريب أو التعاون، أو لتسجيل اهتمامك بالاستشارة عن بعد، من جميع أنحاء الأردن.',
  },
  en: {
    title: 'Speranza Health | Wound Care Platform in Jordan',
    description: 'Speranza Health is a Jordanian digital wound-care platform founded by Aissar Shawaqfeh, CWS®: reliable education, training, and remote consultation coming soon.',
    eyebrow: 'Speranza · Hope',
    h1: 'Speranza Health',
    h1Sub: 'Wound care built on evidence, hope and a multidisciplinary team',
    lead: 'A Jordanian digital platform dedicated to wound care: clear, evidence-based information for patients and families and training for healthcare teams across Jordan, with remote consultation coordinated with a multidisciplinary medical team coming soon.',
    ctaRemote: 'Register interest in remote consultation',
    ctaRemoteLive: 'Ask about remote consultation',
    soon: 'Coming soon',
    soonP: 'We are completing the medical team for this service. The physicians’ names and specialties will be published here at launch. Register your interest and we will contact you when it opens.',
    remoteTeamSoon: 'Specialties the team is planned to include:',
    ctaServices: 'See the services',
    logoAlt: 'Speranza Health logo: a star with a bird rising inside it, wings spread',
    meaningH: 'What does “Speranza” mean?',
    meaningWord: 'Speranza',
    meaningIs: 'is the Italian word for',
    meaningValue: 'hope',
    meaning: [
      'A wound that will not heal wears down the patient and the family. After months of appointments, dressings and home remedies, many of them lose hope.',
      'We chose the name Speranza because the hope we mean is not a promise of a result. It is hope built on a proper assessment, clear knowledge and a team working together around the patient.',
    ],
    purposeH: 'Why we created Speranza',
    purposeLead: 'Good wound care in Jordan needs three things working together:',
    purpose: [
      ['Reliable information in Arabic and English', 'Educational content based on international guidelines that helps patients and families understand the wound, recognise warning signs and avoid common mistakes.'],
      ['A clear route to the right specialty', 'A complex wound usually needs more than one specialty. We coordinate opinions with the multidisciplinary team instead of moving from one trial to the next.'],
      ['Better everyday practice', 'Training and education for healthcare teams, to spread current wound-care practice in hospitals and health centres.'],
    ],
    founderLine: 'Speranza Health was founded by',
    founderTitle: 'Registered Nurse and Certified Wound Specialist, CWS®',
    founderCta: 'About the founder',
    servicesH: 'Services',
    remoteTag: 'Service',
    remoteH: 'Remote consultation with the multidisciplinary medical team',
    remoteP: 'A remote session (video or voice call) to understand the wound, its history and what has already been tried, then coordinate an opinion with the right specialty from the multidisciplinary medical team, and explain the next step to the patient and family.',
    remoteTeam: 'Specialties coordinated with, as each case requires:',
    remoteNotes: [
      'Diagnosis, prescribing and surgical decisions are made by the responsible physician within the team.',
      'A remote consultation does not replace a clinical examination when the situation needs one.',
      'Please don’t send photos or medical reports until a secure way to share them has been agreed.',
      'Emergencies are not managed remotely: go to the nearest emergency department.',
    ],
    services: [
      { icon: 'care', h: 'Guidance by wound type', p: 'Practical information and guidance for each type of wound, and when a wound needs urgent review.', links: careNav },
      { icon: 'layers', h: 'Advanced wound dressings guide', p: 'The main types of modern dressing, what each is made of and what it is typically used for, with a finder by wound situation.', href: 'dressings', cta: 'Advanced wound dressings' },
      { icon: 'image', h: 'Healing journeys gallery', p: 'Real, photo-documented healing stages of different wounds, with patient consent. A private gallery opened with a personal code.', href: 'journeys', cta: 'About the gallery' },
      { icon: 'teach', h: 'Education and training for healthcare teams', p: 'Lectures and hands-on workshops for nurses and caregivers on wound assessment, dressing selection and negative pressure wound therapy.', href: 'education', cta: 'Education and training' },
      { icon: 'book', h: 'Education for patients and families', p: 'Clear, regularly reviewed articles with scientific references, so families can take part in care with confidence.', href: 'articles', cta: 'All articles' },
    ],
    approachH: 'How we work',
    approach: [
      ['Evidence-based assessment', 'Care decisions follow recognised international wound-care guidelines.'],
      ['Follow-up and measurement', 'Measuring and documenting the wound regularly to see whether the plan is working or needs to change.'],
      ['Families as partners', 'Clear, practical explanations, written down when needed, because families are central to a plan that works.'],
      ['A clear scope of practice', 'Each specialty works within its own scope, with no promises of guaranteed outcomes.'],
    ],
    articlesH: 'From our educational articles',
    allArticles: 'All articles',
    contactH: 'Contact',
    contactP: 'For training or collaboration, or to register interest in remote consultation, from anywhere in Jordan.',
  },
}[lang];

const schema = pageGraph({ lang, key: 'home', type: 'WebPage', title: copy.title, description: copy.description, dateModified: updated });
const ref = { lang, page: 'home', placement: 'hero' };
const remoteHref = `${path(lang, 'contact')}?reason=remote`;
const live = flags.remoteConsultationLive;
const ctaRemote = live ? copy.ctaRemoteLive : copy.ctaRemote;
const featured = ['when-to-see-a-wound-care-specialist', 'wound-infection-warning-signs', 'home-wound-care-mistakes']
  .map((slug) => articles.find((a) => a.slug === slug)!)
  .filter(Boolean);
const specialties = team.filter((m) => m.id !== 'other');
---
<BaseLayout lang={lang} pageKey="home" title={copy.title} description={copy.description} schema={schema}>
  <section class="hero brand-hero">
    <div class="wrap">
      <div>
        <p class="brand-eyebrow"><span lang="it">Speranza</span> · {lang === 'ar' ? 'الأمل' : 'Hope'}</p>
        <h1><span class="h1-name">{copy.h1}</span><span class="visually-hidden">{lang === 'ar' ? '، ' : ': '}</span><span class="h1-title">{copy.h1Sub}</span></h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href={remoteHref} {...track('cta_click', { ...ref, placement: 'hero-remote' })}><Icon name="video" />{ctaRemote}</a>
          <a class="btn btn-secondary" href="#services" {...track('cta_click', { ...ref, placement: 'hero-services' })}>{copy.ctaServices}</a>
        </div>
      </div>
      <div class="brand-logo-hero">
        <img src={site.logo.stacked} width={site.logo.stackedSize.w} height={site.logo.stackedSize.h} alt={copy.logoAlt} fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section meaning" aria-labelledby="meaning-h">
    <div class="wrap meaning-grid">
      <div class="meaning-word" aria-hidden="true">
        <span class="mw-word" lang="it">{copy.meaningWord}</span>
        <span class="mw-eq">{copy.meaningIs}</span>
        <span class="mw-value">{copy.meaningValue}</span>
      </div>
      <div class="prose">
        <h2 id="meaning-h" class="flush">{copy.meaningH}</h2>
        <p class="lead-sm"><strong><span lang="it">Speranza</span> {copy.meaningIs} {lang === 'ar' ? `«${copy.meaningValue}»` : `“${copy.meaningValue}”`}.</strong></p>
        {copy.meaning.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="purpose-h">
    <div class="wrap">
      <h2 id="purpose-h" class="flush">{copy.purposeH}</h2>
      <p>{copy.purposeLead}</p>
      <ol class="purpose-list" role="list">
        {copy.purpose.map(([h, p], i) => (
          <li><span class="pl-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p>{p}</p></li>
        ))}
      </ol>
      <p class="founder-line">
        {copy.founderLine} <a href={path(lang, 'about')} {...track('cta_click', { ...ref, placement: 'founder-line' })}><strong>{person.name[lang]}</strong></a>{lang === 'ar' ? '، ' : ', '}{copy.founderTitle}.
        <a class="founder-cta" href={path(lang, 'about')}>{copy.founderCta} <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a>
      </p>
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-h">
    <div class="wrap">
      <h2 id="services-h" class="flush">{copy.servicesH}</h2>

      <article class="service-feature" aria-labelledby="remote-h">
        <div class="sf-main">
          <span class="sf-icon" aria-hidden="true"><Icon name="video" /></span>
          {!live && <span class="soon-badge">{copy.soon}</span>}
          <h3 id="remote-h">{copy.remoteH}</h3>
          <p>{copy.remoteP}</p>
          {!live && <p class="soon-note">{copy.soonP}</p>}
          <p class="sf-team-h">{live ? copy.remoteTeam : copy.remoteTeamSoon}</p>
          <ul class="chips" role="list">{specialties.map((m) => <li>{m[lang]}</li>)}</ul>
          <div class="actions">
            <a class="btn btn-primary" href={remoteHref} {...track('cta_click', { lang, page: 'home', placement: 'services-remote' })}>{ctaRemote}</a>
          </div>
        </div>
        <ul class="sf-notes" role="list">
          {copy.remoteNotes.map((n) => <li><Icon name="check" />{n}</li>)}
        </ul>
      </article>

      <ul class="service-list" role="list">
        {copy.services.map((sv) => (
          <li class="service-card">
            <span class="sf-icon" aria-hidden="true"><Icon name={sv.icon as 'care' | 'teach' | 'book' | 'layers' | 'image'} /></span>
            <h3>{sv.h}</h3>
            <p>{sv.p}</p>
            {sv.links
              ? <ul class="service-links">{sv.links.map((k) => <li><a href={path(lang, k)}>{pages[k].nav[lang]}</a></li>)}</ul>
              : <p class="service-more"><a href={path(lang, sv.href as 'education' | 'articles' | 'dressings' | 'journeys')}>{sv.cta} <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a></p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap"><TeamSection lang={lang} /></div>
  </section>

  <section class="section" aria-labelledby="approach-h">
    <div class="wrap">
      <h2 id="approach-h" class="flush">{copy.approachH}</h2>
      <div class="grid-2">
        {copy.approach.map(([h, p]) => (<div><h3 style="margin-top:0">{h}</h3><p>{p}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="articles-h">
    <div class="wrap">
      <h2 id="articles-h" class="flush">{copy.articlesH}</h2>
      <ArticleCards lang={lang} items={featured} showTopic={false} />
      <p><a href={path(lang, 'articles')}>{copy.allArticles}</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-h">
    <div class="wrap prose">
      <h2 id="contact-h" class="flush">{copy.contactH}</h2>
      <p>{copy.contactP}</p>
      <p class="muted">{s.emergencyShort}</p>
      <ContactActions lang={lang} page="home" placement="contact-band" />
    </div>
  </section>
</BaseLayout>
