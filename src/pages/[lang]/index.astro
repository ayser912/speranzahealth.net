---
/**
 * Homepage (slimmed down 24 Nov 2026 at Aissar's request, items 2–10):
 * 1) a compact introduction to Speranza Health,
 * 2) right under it, two announcements side by side: remote consultation (book now) and the ABWM exam
 *    preparation for healthcare professionals,
 * 3) the awareness videos, then the contact band.
 * Removed from the homepage: the meaning of «Speranza», why we created it, the services list, the
 * multidisciplinary team, how we work, and the featured articles (all still covered on their own pages).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactActions from '../../components/ContactActions.astro';
import VideoSection from '../../components/VideoSection.astro';
import AbwmPromo from '../../components/AbwmPromo.astro';
import LogoArt from '../../components/LogoArt.astro';
import Icon from '../../components/Icon.astro';
import { site, flags, type Lang } from '../../config/site';
import { path, langs } from '../../lib/routes';
import { pageGraph } from '../../lib/schema';
import { track } from '../../lib/links';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const updated = '2026-11-24';

const copy = {
  ar: {
    title: 'سبيرانزا هيلث | منصة عربية للعناية بالجروح واستشارات عن بعد',
    description: 'سبيرانزا هيلث: منصة رقمية عربية للعناية بالجروح موجّهة لكل العالم، أسسها أيسر شواقفه CWS®. استشارة عن بعد مع المختص المعني، وتثقيف موثوق، وتدريب للكوادر الصحية.',
    h1: 'سبيرانزا هيلث',
    h1Sub: 'العناية بالجروح بالعلم والأمل، وبفريق متعدد التخصصات',
    lead: 'منصة رقمية عربية متخصصة في العناية بالجروح، موجّهة لكل الناس حول العالم: استشارة عن بعد مع المختص المعني من فريق طبي متعدد التخصصات، ومعلومة واضحة ومبنية على الدليل العلمي للمرضى والأسر، وتدريب للكوادر الصحية.',
    logoAlt: 'شعار سبيرانزا هيلث: نجمة يحلّق في داخلها طائر بجناحين مفتوحين',
    promos: 'إعلانات',
    remoteTag: 'الاستشارة عن بعد',
    liveBadge: 'متاحة الآن',
    soon: 'قريبًا',
    remoteH: 'الاستشارة عن بعد مع المختص المعني',
    remoteP: 'تقدّم المنصة التشخيص أو النصيحة الطبية عبر استشارة عن بعد (اتصال مرئي أو صوتي) مع المختص المعني من الفريق الطبي متعدد التخصصات، أو عبر زيارة منزلية، أو حجز موعد في العيادة أو المركز، حسب ما تحتاجه الحالة.',
    soonP: 'نعمل حاليًا على استكمال الفريق الطبي لهذه الخدمة. سجّل اهتمامك وسنتواصل معك عند الإطلاق.',
    how: ['استشارة عن بعد (مرئية أو صوتية)', 'زيارة منزلية', 'موعد في العيادة أو المركز'],
    ctaRemote: 'سجّل اهتمامك بالاستشارة عن بعد',
    ctaRemoteLive: 'احجز استشارة عن بعد الآن',
    profilesCta: 'التخصصات والمختصون وأوقات التواجد',
    remoteNote: 'لا تُغني الاستشارة عن بعد عن الفحص السريري عندما تتطلبه الحالة.',
    contactH: 'التواصل',
    contactP: 'لطلب استشارة عن بعد أو زيارة منزلية أو موعد في العيادة أو المركز، أو للاستفسار عن التدريب والتعاون، من أي مكان في العالم.',
  },
  en: {
    title: 'Speranza Health | Wound-Care Platform and Remote Consultation',
    description: 'Speranza Health is an Arabic digital wound-care platform for a global audience, founded by Aissar Shawaqfeh, CWS®: remote consultation, reliable education and training.',
    h1: 'Speranza Health',
    h1Sub: 'Wound care built on evidence, hope and a multidisciplinary team',
    lead: 'An Arabic digital platform dedicated to wound care, for people worldwide: remote consultation with the relevant specialist from a multidisciplinary medical team, clear evidence-based information for patients and families, and training for healthcare teams.',
    logoAlt: 'Speranza Health logo: a star with a bird rising inside it, wings spread',
    promos: 'Announcements',
    remoteTag: 'Remote consultation',
    liveBadge: 'Available now',
    soon: 'Coming soon',
    remoteH: 'Remote consultation with the relevant specialist',
    remoteP: 'The platform provides a diagnosis or medical advice through a remote consultation (video or voice call) with the relevant specialist from the multidisciplinary medical team, a home visit, or an appointment at the clinic or centre, depending on what the case needs.',
    soonP: 'We are completing the medical team for this service. Register your interest and we will contact you when it opens.',
    how: ['Remote consultation (video or voice)', 'Home visit', 'Clinic or centre appointment'],
    ctaRemote: 'Register interest in remote consultation',
    ctaRemoteLive: 'Book a remote consultation now',
    profilesCta: 'Specialties, specialists and hours',
    remoteNote: 'A remote consultation does not replace a clinical examination when the situation needs one.',
    contactH: 'Contact',
    contactP: 'To request a remote consultation, a home visit or a clinic or centre appointment, or to ask about training and collaboration, from anywhere in the world.',
  },
}[lang];

const schema = pageGraph({ lang, key: 'home', type: 'WebPage', title: copy.title, description: copy.description, dateModified: updated });
const live = flags.remoteConsultationLive;
const remoteHref = live ? path(lang, 'consult') : `${path(lang, 'contact')}?reason=remote`;
---
<BaseLayout lang={lang} pageKey="home" title={copy.title} description={copy.description} schema={schema}>
  <section class="hero brand-hero hero-compact">
    <div class="wrap">
      <div class="hc-text">
        <p class="brand-eyebrow"><span lang="it">Speranza</span> · {lang === 'ar' ? 'الأمل' : 'Hope'}</p>
        <h1><span class="h1-name">{copy.h1}</span><span class="visually-hidden">{lang === 'ar' ? '، ' : ': '}</span><span class="h1-title">{copy.h1Sub}</span></h1>
        <p class="lead">{copy.lead}</p>
      </div>
      <div class="brand-logo-hero">
        <LogoArt which="stacked" width={site.logo.stackedSize.w} height={site.logo.stackedSize.h} label={copy.logoAlt} />
      </div>
    </div>
  </section>

  <section class="section promos" aria-label={copy.promos}>
    <div class="wrap promo-grid">
      <article class="consult-promo" aria-labelledby="consult-promo-h">
        <p class="cp-eyebrow"><Icon name="video" />{copy.remoteTag}<span class="cp-badge"><span class="cp-dot" aria-hidden="true"></span>{live ? copy.liveBadge : copy.soon}</span></p>
        <h2 id="consult-promo-h">{copy.remoteH}</h2>
        <p class="cp-lead">{live ? copy.remoteP : copy.soonP}</p>
        {live && <ul class="chips" role="list">{copy.how.map((x) => <li>{x}</li>)}</ul>}
        <div class="actions">
          <a class="btn btn-primary" href={remoteHref} {...track('cta_click', { lang, page: 'home', placement: 'promo-remote' })}><Icon name="video" />{live ? copy.ctaRemoteLive : copy.ctaRemote}</a>
          {live && <a class="btn btn-secondary" href={`${path(lang, 'consult')}#specialties`} {...track('cta_click', { lang, page: 'home', placement: 'promo-specialties' })}>{copy.profilesCta}</a>}
        </div>
        <p class="muted cp-note">{copy.remoteNote}</p>
      </article>
      <AbwmPromo lang={lang} page="home" variant="card" />
    </div>
  </section>

  <section class="section section-alt home-videos">
    <div class="wrap"><VideoSection lang={lang} page="home" /></div>
  </section>

  <section class="section" aria-labelledby="contact-h">
    <div class="wrap prose">
      <h2 id="contact-h" class="flush">{copy.contactH}</h2>
      <p>{copy.contactP}</p>
      <ContactActions lang={lang} page="home" placement="contact-band" />
    </div>
  </section>
</BaseLayout>
