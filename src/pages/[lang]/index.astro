---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactActions from '../../components/ContactActions.astro';
import TeamSection from '../../components/TeamSection.astro';
import VideoSection from '../../components/VideoSection.astro';
import Portrait from '../../components/Portrait.astro';
import ArticleCards from '../../components/ArticleCards.astro';
import FeaturedInterview from '../../components/FeaturedInterview.astro';
import { person, credentials, yearsExperience, type Lang } from '../../config/site';
import { path, langs, credentialsHref, type PageKey } from '../../lib/routes';
import { pageGraph, featuredVideoNode } from '../../lib/schema';
import { t } from '../../lib/i18n';
import { track } from '../../lib/links';
import { articles } from '../../content/articles/index';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const s = t(lang);
const yrs = yearsExperience();
const cws = credentials.find((c) => c.id === 'cws')!;

const copy = {
  ar: {
    title: 'أيسر شواقفه | أخصائي معتمد للعناية بالجروح في الأردن',
    description: 'أيسر شواقفه، ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS® في الأردن، بخبرة في الجروح المزمنة وقرح الضغط والقدم السكري والعلاج بالضغط السلبي.',
    h1Name: 'أيسر شواقفه',
    h1Title: 'ممرض قانوني وأخصائي معتمد في العناية بالجروح CWS®',
    lead: `خبرة تمتد لنحو ${yrs} سنوات في القطاع الصحي، تركّز على الجروح التي لا تلتئم كما يُتوقع، بالتنسيق مع فريق متعدد التخصصات، مع تثقيف واضح للمرضى والأسر وتدريب للكوادر الصحية في جميع أنحاء الأردن.`,
    badgeSub: 'أخصائي معتمد في العناية بالجروح',
    verify: 'تحقق من الاعتماد',
    areasH: 'العناية بالجروح',
    areas: [
      ['chronic', 'الجروح المزمنة', 'لماذا يتأخر التئام الجرح، وعلامات الخطر، وما يشمله التقييم المتخصص.'],
      ['pressure', 'قرح الضغط (قرح الفراش)', 'الوقاية والمراحل وفحص الجلد اليومي للمرضى قليلي الحركة.'],
      ['diabeticFoot', 'جروح القدم السكري', 'لماذا يحتاج جرح القدم لدى مريض السكري إلى اهتمام سريع.'],
      ['surgical', 'الجروح الجراحية', 'ما هو طبيعي بعد العملية، ومتى تتواصل مع الجرّاح.'],
      ['npwt', 'العلاج بالضغط السلبي NPWT', 'كيف يعمل جهاز VAC، ولمن يناسب، والحياة اليومية معه.'],
      ['education', 'التعليم والتدريب', 'محاضرات وورش عملية للممرضين ومقدمي الرعاية.'],
    ],
    approachH: 'منهج العمل',
    approach: [
      ['تقييم مبني على الدليل', 'قرارات العناية تستند إلى الإرشادات الدولية المعتمدة في العناية بالجروح.'],
      ['متابعة وقياس التقدم', 'قياس الجرح وتوثيقه بانتظام لمعرفة ما إذا كانت الخطة تعمل أو تحتاج إلى تعديل.'],
      ['تثقيف المريض والأسرة', 'شرح واضح وعملي ومكتوب عند الحاجة، لأن الأسرة جزء أساسي من العناية.'],
      ['وضوح في نطاق الممارسة', 'العمل ضمن نطاق ممارسة التمريض في الأردن، دون وعود بنتائج علاجية مضمونة.'],
    ],
    articlesH: 'مقالات تثقيفية',
    allArticles: 'كل المقالات',
    contactH: 'التواصل',
    contactP: 'للاستفسارات والتدريب والتعاون من جميع أنحاء الأردن. لا تُرسل صورًا أو تقارير طبية عبر الرسائل قبل الاتفاق على طريقة آمنة.',
  },
  en: {
    title: 'Aissar Shawaqfeh | Certified Wound Specialist in Jordan',
    description: 'Aissar Shawaqfeh is a Registered Nurse and Certified Wound Specialist in Jordan, experienced in chronic wounds, pressure injuries, diabetic foot and NPWT.',
    h1Name: 'Aissar Shawaqfeh',
    h1Title: 'Registered Nurse and Certified Wound Specialist, CWS®',
    lead: `About ${yrs} years in healthcare, focused on wounds that are not healing as expected, coordinated with a multidisciplinary team, with clear education for patients and families and training for healthcare teams across Jordan.`,
    badgeSub: 'Certified Wound Specialist',
    verify: 'Verify the credential',
    areasH: 'Wound care',
    areas: [
      ['chronic', 'Chronic wounds', 'Why healing stalls, the warning signs, and what a specialist assessment covers.'],
      ['pressure', 'Pressure injuries (bedsores)', 'Prevention, stages and daily skin checks for people with limited mobility.'],
      ['diabeticFoot', 'Diabetic foot wounds', 'Why a foot wound in a person with diabetes needs prompt attention.'],
      ['surgical', 'Surgical wounds', 'What is normal after surgery, and when to contact your surgeon.'],
      ['npwt', 'Negative pressure wound therapy', 'How VAC therapy works, who it may suit, and daily life with the device.'],
      ['education', 'Education and training', 'Lectures and hands-on workshops for nurses and caregivers.'],
    ],
    approachH: 'How care is approached',
    approach: [
      ['Evidence-based assessment', 'Care decisions follow recognised international wound-care guidelines.'],
      ['Follow-up and measurement', 'Measuring and documenting the wound regularly to see whether the plan is working or needs to change.'],
      ['Education for patients and families', 'Clear, practical explanations, written down when needed, because families are central to care.'],
      ['A clear scope of practice', 'Work stays within the nursing scope of practice in Jordan, with no promises of guaranteed outcomes.'],
    ],
    articlesH: 'Educational articles',
    allArticles: 'All articles',
    contactH: 'Contact',
    contactP: 'For enquiries, training and collaboration from anywhere in Jordan. Please don’t send photos or medical reports by message until a secure method has been agreed.',
  },
}[lang];

const schema = pageGraph({ lang, key: 'home', type: 'WebPage', title: copy.title, description: copy.description, dateModified: '2026-10-10' });
(schema['@graph'] as unknown[]).push(featuredVideoNode(lang, path(lang, 'home')));
const ctaRef = { lang, page: 'home', placement: 'hero' };
const featured = ['when-to-see-a-wound-care-specialist', 'wound-infection-warning-signs', 'home-wound-care-mistakes']
  .map((slug) => articles.find((a) => a.slug === slug)!)
  .filter(Boolean);
---
<BaseLayout lang={lang} pageKey="home" title={copy.title} description={copy.description} schema={schema} ogType="profile">
  <section class="hero">
    <div class="wrap">
      <div>
        <h1><span class="h1-name">{copy.h1Name}</span><span class="h1-title">{copy.h1Title}</span></h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href={path(lang, 'contact')} {...track('cta_click', { ...ctaRef, placement: 'hero-contact' })}>{s.contactCta}</a>
          <a class="btn btn-secondary" href={credentialsHref(lang)} {...track('cta_click', { ...ctaRef, placement: 'hero-credentials' })}>{s.credentialsCta}</a>
        </div>
      </div>
      {person.photo
        ? <Portrait lang={lang} eager verify />
        : (
          <div class="record">
            <div class="record-head">
              <span class="record-mark" aria-hidden="true">CWS®</span>
            </div>
            <p class="record-line"><strong>{copy.badgeSub}</strong></p>
            <p class="record-line" lang="en">{cws.issuer.en}</p>
            <p class="record-verify"><a href={cws.verifyUrl} rel="noopener">{copy.verify}</a></p>
          </div>
        )}
    </div>
  </section>

  <FeaturedInterview lang={lang} />

  <section class="section" aria-labelledby="areas-h">
    <div class="wrap">
      <h2 id="areas-h" class="flush">{copy.areasH}</h2>
      <ul class="topic-list">
        {copy.areas.map(([k, h, p]) => (
          <li><h3><a href={path(lang, k as PageKey)}>{h}</a></h3><p>{p}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap"><TeamSection lang={lang} /></div>
  </section>

  <section class="section" aria-labelledby="approach-h">
    <div class="wrap">
      <h2 id="approach-h" class="flush">{copy.approachH}</h2>
      <div class="grid-2">
        {copy.approach.map(([h, p]) => (<div><h3 style="margin-top:0">{h}</h3><p>{p}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap"><VideoSection lang={lang} page="home" /></div>
  </section>

  <section class="section" aria-labelledby="articles-h">
    <div class="wrap">
      <h2 id="articles-h" class="flush">{copy.articlesH}</h2>
      <ArticleCards lang={lang} items={featured} showTopic={false} />
      <p><a href={path(lang, 'articles')}>{copy.allArticles}</a></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="contact-h">
    <div class="wrap prose">
      <h2 id="contact-h" class="flush">{copy.contactH}</h2>
      <p>{copy.contactP}</p>
      <ContactActions lang={lang} page="home" placement="contact-band" />
    </div>
  </section>
</BaseLayout>
