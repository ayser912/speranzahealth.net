---
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/platform.css';
import { site, analytics, person, type Lang } from '../config/site';
import { path, otherLang, isPublic, type PageKey } from '../lib/routes';
import { abs } from '../lib/schema';
import { t } from '../lib/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmergencyBar from '../components/EmergencyBar.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Lang;
  /** Registry key; omit for pages outside the registry (404, articles). */
  pageKey?: PageKey;
  /** Explicit per-language paths for pages outside the registry (articles). */
  paths?: Record<Lang, string>;
  /** Which main-nav item to mark current when pageKey is absent (e.g. 'articles'). */
  navKey?: PageKey;
  title: string;
  description: string;
  schema?: object;
  noindex?: boolean;
  ogType?: 'website' | 'profile' | 'article';
}

const { lang, pageKey, paths, navKey, title, description, schema, noindex: noindexProp = false, ogType = 'website' } = Astro.props;
/** Hidden pages (src/config/launch.ts) are always noindex, so they stay out of search engines and the site search. */
const noindex = noindexProp || (pageKey ? !isPublic(pageKey) : false);
const s = t(lang);
const langPaths: Record<Lang, string> | undefined = pageKey ? { ar: path('ar', pageKey), en: path('en', pageKey) } : paths;
const canonical = langPaths ? abs(langPaths[lang]) : undefined;
const alt = otherLang(lang);
const hreflangs = langPaths
  ? [
      { hreflang: 'ar', href: abs(langPaths.ar) },
      { hreflang: 'en', href: abs(langPaths.en) },
      { hreflang: 'x-default', href: abs(langPaths.ar) },
    ]
  : [];
const ogImage = abs(`/og/${lang}.png`);
---
<!doctype html>
<html lang={site.locales[lang]} dir={s.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <meta name="author" content={`${person.name[lang]}, ${person.postNominals}`} />
    <meta name="theme-color" content="#064f3d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {lang === 'ar'
      ? <Fragment>
          <link rel="preload" href="/fonts/plex-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/plex-arabic-600.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/plex-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
        </Fragment>
      : <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />}
    {analytics.gscVerification && <meta name="google-site-verification" content={analytics.gscVerification} />}

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.siteName[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={site.ogLocale[lang]} />
    <meta property="og:locale:alternate" content={site.ogLocale[alt]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'ar' ? 'شعار سبيرانزا هيلث — العناية بالجروح بفريق متعدد التخصصات' : 'Speranza Health logo — wound care with a multidisciplinary team'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      /* Motion style 3 «تموّج دائري»: remember where a link was clicked, and when the next page arrives with a
         page transition, show the green circle (.vt-ripple, motion.css) growing from that point. */
      (function () {
        if (!('onpagereveal' in window)) return;
        var d = document.documentElement;
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          var p = null;
          try { p = JSON.parse(sessionStorage.getItem('sh-vt') || 'null'); sessionStorage.removeItem('sh-vt'); } catch (_) {}
          var w = innerWidth, h = innerHeight;
          if (!(p && Date.now() - p.t < 8000)) p = { x: w / 2, y: h / 2 };
          /* the circle's full size = distance from the click to the farthest corner, so it grows at an even pace */
          var r = Math.ceil(Math.hypot(Math.max(p.x, w - p.x), Math.max(p.y, h - p.y)));
          d.style.setProperty('--vt-x', p.x + 'px'); d.style.setProperty('--vt-y', p.y + 'px'); d.style.setProperty('--vt-r', r + 'px');
          d.classList.add('vt-go');
          e.viewTransition.finished.finally(function () { d.classList.remove('vt-go'); });
        });
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var r = a.getBoundingClientRect();
          var x = e.detail ? e.clientX : r.left + r.width / 2, y = e.detail ? e.clientY : r.top + r.height / 2;
          try { sessionStorage.setItem('sh-vt', JSON.stringify({ x: Math.round(x), y: Math.round(y), t: Date.now() })); } catch (_) {}
        }, true);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <EmergencyBar lang={lang} />
    <Header lang={lang} pageKey={pageKey ?? navKey} altHref={langPaths ? langPaths[alt] : undefined} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} pageKey={pageKey} />
    <div class="vt-ripple" aria-hidden="true"></div>
    <Analytics lang={lang} />
    <script is:inline>
      /* Motion style 3: buttons, menu entries and tabs ripple from the point you press. */
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var sel = '.btn, .header-consult, .nav-toggle, .nav-close, .nav-list a, .sub-toggle, .fmenu-toggle, .fmenu-list a, .lang-switch, .filter-chips button, .video-cta, .video-teaser a, .vlib-play';
        document.addEventListener('pointerdown', function (e) {
          var h = e.target.closest && e.target.closest(sel);
          if (!h || e.button > 0) return;
          var cs = getComputedStyle(h);
          if (cs.position === 'static') h.style.position = 'relative';
          if (cs.isolation !== 'isolate') h.style.isolation = 'isolate';
          var r = h.getBoundingClientRect(), s = Math.max(r.width, r.height) * 2.3;
          var box = document.createElement('span'), dot = document.createElement('i');
          box.className = 'rp'; box.setAttribute('aria-hidden', 'true');
          dot.style.cssText = 'width:' + s + 'px;height:' + s + 'px;left:' + (e.clientX - r.left - s / 2) + 'px;top:' + (e.clientY - r.top - s / 2) + 'px';
          box.appendChild(dot); h.appendChild(box);
          setTimeout(function () { box.remove(); }, 750);
        });
      })();
    </script>
    <script is:inline>
      /* Scroll reveal: only for elements that start below the fold, only when motion is welcome. */
      (function () {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var sel = [
          'main h2', '.topic-list > li', '.purpose-list > li', '.service-list > li', '.service-feature', '.meaning-word', '.dress-card', '.dg-head', '.card-list > li', '.team-list > li', '.grid-2 > *',
          '.promo-grid > *', '.video-teaser > li',
          '.ill', '.record', '.author-box', '.callout', '.toc', '.video-cta', '.video',
          '.form', 'table.data', '.references', '.disclosure', '.portrait', '.contact-actions', '.actions'
        ].join(',');
        var fold = window.innerHeight * 0.92;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var t = e.target;
            io.unobserve(t);
            t.classList.add('in');
            /* Once settled, drop the reveal classes so hover transitions behave normally. */
            setTimeout(function () { t.classList.remove('reveal'); if (!t.matches('.ill')) t.classList.remove('in'); t.style.removeProperty('--i'); }, 1100);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        document.querySelectorAll('main ' + sel.split(',').join(', main ')).forEach(function (el) {
          if (el.closest('.hero, .page-head') || el.getBoundingClientRect().top < fold) {
            if (el.matches('.ill')) el.classList.add('in');
            return;
          }
          if (el.parentElement && el.parentElement.closest('.reveal')) return; /* parent already animates */
          var sib = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
          if (el.matches('li, .grid-2 > *')) el.style.setProperty('--i', String(Math.min(sib, 5)));
          el.classList.add('reveal');
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
