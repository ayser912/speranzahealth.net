---
import type { Lang } from '../config/site';
import { t } from '../lib/i18n';
export interface Ref { text: string; url: string }
/** `allHref`: articles keep their references collapsed and link to the full list on the wound-care hub (Aissar, 11 Nov 2026). */
interface Props { lang: Lang; items: Ref[]; allHref?: string }
const { lang, items, allHref } = Astro.props;
const more = lang === 'ar' ? 'مراجع جميع المقالات في صفحة الأدلة والمقالات' : 'References for all articles on the guides and articles page';
---
<section class="references prose" aria-labelledby="refs-h">
  <h2 id="refs-h">{t(lang).references}</h2>
  {allHref ? (
    <details class="refs-details">
      <summary>{lang === 'ar' ? `عرض المراجع (${items.length})` : `Show references (${items.length})`}</summary>
      <ol lang="en" dir="ltr">
        {items.map((r) => <li><a href={r.url} rel="noopener">{r.text}</a></li>)}
      </ol>
    </details>
  ) : (
    <ol lang="en" dir="ltr">
      {items.map((r) => <li><a href={r.url} rel="noopener">{r.text}</a></li>)}
    </ol>
  )}
  {allHref && <p><a href={allHref}>{more}</a></p>}
</section>
