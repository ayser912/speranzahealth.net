---
/**
 * Original, non-graphic explanatory illustrations (no wound or patient imagery).
 * Drawn as inline SVG so they stay sharp, light and readable in Arabic and English.
 */
import type { Lang } from '../config/site';
export type IllustrationName = 'team' | 'time' | 'pressure' | 'foot' | 'npwt' | 'surgical';
interface Props { lang: Lang; name: IllustrationName }
const { lang, name } = Astro.props;
const ar = lang === 'ar';
/** In RTL, SVG text-anchor start/end swap sides; flip so geometry stays the same in both languages. */
const A = (a: string) => (ar ? (a === 'start' ? 'end' : a === 'end' ? 'start' : a) : a);

const T = {
  team: {
    caption: ar ? 'العناية بالجرح المعقد عمل فريق متعدد التخصصات، والمريض وأسرته في مركزه.' : 'Complex wound care is a multidisciplinary team effort, with the patient and family at the centre.',
    center: ar ? ['المريض', 'والجرح'] : ['Patient', '& wound'],
    nodes: ar
      ? ['تمريض الجروح CWS®', 'جراحة العظام', 'الأوعية الدموية', 'الجراحة العامة', 'الجراحة التجميلية', 'طب القدم', 'الأمراض المعدية', 'التغذية العلاجية']
      : ['Wound nursing (CWS®)', 'Orthopaedics', 'Vascular surgery', 'General surgery', 'Plastic surgery', 'Podiatry', 'Infectious diseases', 'Nutrition'],
  },
  time: {
    caption: ar ? 'إطار TIME: أربعة أسئلة يطرحها المختص عن كل جرح لا يلتئم.' : 'The TIME framework: four questions a specialist asks about every non-healing wound.',
    center: ar ? 'قاع الجرح' : 'Wound bed',
    q: ar
      ? [['T', 'الأنسجة', 'نسيج ميت يحتاج إزالة؟'], ['I', 'العدوى', 'علامات عدوى أو biofilm؟'], ['M', 'الرطوبة', 'جاف جدًا أم رطب جدًا؟'], ['E', 'الحواف', 'هل تتقدم الحواف؟']]
      : [['T', 'Tissue', 'Dead tissue to remove?'], ['I', 'Infection', 'Signs of infection or biofilm?'], ['M', 'Moisture', 'Too dry or too wet?'], ['E', 'Edge', 'Are the edges advancing?']],
  },
  pressure: {
    caption: ar ? 'أكثر مواضع قرح الضغط شيوعًا لدى المريض المستلقي على ظهره. افحص هذه المناطق يوميًا.' : 'The most common pressure injury sites when lying on the back. Check these areas every day.',
    labels: ar ? ['مؤخرة الرأس', 'لوحا الكتف', 'المرفق', 'العجز (أسفل الظهر)', 'الكعب'] : ['Back of head', 'Shoulder blades', 'Elbow', 'Sacrum (lower back)', 'Heel'],
  },
  foot: {
    caption: ar ? 'فحص القدم اليومي لمريض السكري: انظر إلى هذه المناطق، واستخدم مرآة عند الحاجة.' : 'Daily foot check for people with diabetes: look at these areas, using a mirror if needed.',
    labels: ar ? ['أطراف الأصابع', 'بين الأصابع', 'مقدمة باطن القدم', 'جانب القدم', 'الكعب'] : ['Toe tips', 'Between the toes', 'Ball of the foot', 'Side of the foot', 'Heel'],
  },
  npwt: {
    caption: ar ? 'مكوّنات العلاج بالضغط السلبي: حشوة في الجرح، وغشاء يغلقه، وأنبوب، وجهاز يولّد الضغط، وعبوة للإفرازات.' : 'Parts of negative pressure wound therapy: a filler in the wound, a sealing film, tubing, a pump and a fluid canister.',
    labels: ar ? ['الحشوة (إسفنج)', 'الغشاء اللاصق', 'الأنبوب', 'الجهاز', 'عبوة الإفرازات', 'الجلد'] : ['Filler (foam)', 'Adhesive film', 'Tubing', 'Pump', 'Fluid canister', 'Skin'],
  },
  surgical: {
    caption: ar ? 'جرح العملية: الاحمرار البسيط عند الحواف طبيعي في الأيام الأولى، أما الاحمرار الذي يمتد فهو علامة تستدعي المراجعة.' : 'A surgical wound: mild redness at the edges is normal in the first days; redness that spreads is a sign to get it checked.',
    labels: ar ? ['الغرز', 'احمرار بسيط عند الحواف: طبيعي', 'احمرار يمتد: راجع الجرّاح'] : ['Stitches', 'Mild redness at edges: normal', 'Spreading redness: see the surgeon'],
  },
}[name];

// pressure points: x on the bed line, label position, anchor
const pressurePts = [
  { x: 80, lx: 24, ty: 60, anchor: 'start' },
  { x: 140, lx: 160, ty: 108, anchor: 'middle' },
  { x: 250, lx: 250, ty: 60, anchor: 'middle' },
  { x: 305, lx: 360, ty: 108, anchor: 'middle' },
  { x: 545, lx: 580, ty: 60, anchor: 'end' },
];
// team ring geometry
const ring = Array.from({ length: 8 }, (_, i) => {
  const a = (-90 + i * 45) * (Math.PI / 180);
  return { x: 280 + 205 * Math.cos(a), y: 200 + 150 * Math.sin(a) };
});
---
<figure class="ill">
  {name === 'team' && (
    <svg viewBox="0 0 560 400" role="img" aria-labelledby={`ill-${name}-${lang}`}>
      <title id={`ill-${name}-${lang}`}>{(T as any).caption}</title>
      {ring.map((p) => <line x1="280" y1="200" x2={p.x} y2={p.y} class="ill-link" />)}
      <circle cx="280" cy="200" r="62" class="ill-core" />
      <text x="280" y="194" class="ill-core-t" text-anchor={A('middle')}>{(T as any).center[0]}</text>
      <text x="280" y="220" class="ill-core-t" text-anchor={A('middle')}>{(T as any).center[1]}</text>
      {ring.map((p, i) => (
        <g>
          <rect x={p.x - 78} y={p.y - 19} width="156" height="38" rx="19" class={i === 0 ? 'ill-pill ill-pill-key' : 'ill-pill'} />
          <text x={p.x} y={p.y + 5} text-anchor={A('middle')} class={i === 0 ? 'ill-pill-t ill-pill-t-key' : 'ill-pill-t'}>{(T as any).nodes[i]}</text>
        </g>
      ))}
    </svg>
  )}

  {name === 'time' && (
    <svg viewBox="0 0 560 360" role="img" aria-labelledby={`ill-${name}-${lang}`}>
      <title id={`ill-${name}-${lang}`}>{(T as any).caption}</title>
      {[[20, 20], [300, 20], [20, 200], [300, 200]].map(([x0, y], i) => {
        const x = ar ? 540 - x0 - 220 : x0;
        return (
        <g>
          <rect x={x} y={y} width="240" height="140" rx="14" class="ill-card" />
          <text x={ar ? x + 214 : x + 26} y={y + 52} text-anchor={ar ? "end" : "start"} direction="ltr" class="ill-letter">{(T as any).q[i][0]}</text>
          <text x={ar ? x + 90 : x + 150} y={y + 52} text-anchor={A('middle')} class="ill-h">{(T as any).q[i][1]}</text>
          <text x={x + 120} y={y + 104} text-anchor={A('middle')} class="ill-small">{(T as any).q[i][2]}</text>
        </g>
        );
      })}
      <circle cx="280" cy="180" r="54" class="ill-core" />
      <text x="280" y="186" text-anchor={A('middle')} class="ill-core-t">{(T as any).center}</text>
    </svg>
  )}

  {name === 'pressure' && (
    <svg viewBox="0 0 600 300" role="img" aria-labelledby={`ill-${name}-${lang}`}>
      <title id={`ill-${name}-${lang}`}>{(T as any).caption}</title>
      <rect x="20" y="196" width="560" height="22" rx="6" class="ill-bed" />
      <rect x="20" y="218" width="16" height="50" class="ill-bed" /><rect x="564" y="218" width="16" height="50" class="ill-bed" />
      <circle cx="80" cy="168" r="28" class="ill-body" />
      <rect x="108" y="150" width="210" height="46" rx="22" class="ill-body" />
      <rect x="300" y="160" width="250" height="34" rx="17" class="ill-body" />
      <rect x="150" y="176" width="110" height="18" rx="9" class="ill-limb" />
      {pressurePts.map((pt, i) => (
        <g>
          <line x1={pt.x} y1={pt.ty + 8} x2={pt.x} y2="186" class="ill-lead" />
          <circle cx={pt.x} cy="194" r="9" class="ill-hot" />
          <text x={pt.lx} y={pt.ty} text-anchor={A(pt.anchor)} class="ill-label">{(T as any).labels[i]}</text>
        </g>
      ))}
    </svg>
  )}

  {name === 'foot' && (
    <svg viewBox="-90 0 650 420" role="img" aria-labelledby={`ill-${name}-${lang}`}>
      <title id={`ill-${name}-${lang}`}>{(T as any).caption}</title>
      <path class="ill-body" d="M280 92 C 330 92 350 128 348 170 C 346 214 330 238 330 276 C 330 330 318 380 280 384 C 242 388 228 340 228 290 C 228 246 210 222 210 178 C 210 126 232 92 280 92 Z" />
      {[[232, 70, 15], [262, 52, 18], [296, 50, 18], [326, 62, 15], [350, 84, 12]].map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} class="ill-body" />)}
      {[[262, 52], [247, 74], [292, 158], [214, 230], [280, 350]].map(([x, y]) => <circle cx={x} cy={y} r="8" class="ill-hot" />)}
      {[[262, 52, 440, 40], [247, 74, 120, 74], [292, 158, 440, 158], [214, 230, 120, 230], [280, 350, 440, 350]].map(([x1, y1, x2, y2], i) => (
        <g>
          <line x1={x1} y1={y1} x2={x2 > 300 ? x2 - 8 : x2 + 8} y2={y2} class="ill-lead" />
          <text x={x2 > 300 ? x2 : x2} y={y2 + 5} text-anchor={A(x2 > 300 ? 'start' : 'end')} class="ill-label">{(T as any).labels[i]}</text>
        </g>
      ))}
    </svg>
  )}

  {name === 'npwt' && (
    <svg viewBox="0 0 600 300" role="img" aria-labelledby={`ill-${name}-${lang}`}>
      <title id={`ill-${name}-${lang}`}>{(T as any).caption}</title>
      <path class="ill-skin" d="M20 150 H120 C 130 150 132 158 136 172 L 150 220 C 154 232 160 236 172 236 H 248 C 260 236 266 232 270 220 L 284 172 C 288 158 290 150 300 150 H 340 V 186 H 20 Z" />
      <path class="ill-foam" d="M140 160 L152 212 C 156 224 162 228 172 228 H 248 C 258 228 264 224 268 212 L 280 160 Z" />
      <rect x="110" y="146" width="200" height="8" rx="3" class="ill-film" />
      <path class="ill-tube" d="M210 146 C 210 90 300 70 380 92" fill="none" />
      <rect x="380" y="60" width="150" height="110" rx="16" class="ill-device" />
      <rect x="400" y="80" width="70" height="34" rx="6" class="ill-screen" />
      <rect x="490" y="80" width="26" height="70" rx="6" class="ill-canister" />
      <g class="ill-label">
        <text x="210" y="272" text-anchor={A('middle')}>{(T as any).labels[0]}</text>
        <text x="40" y="132" text-anchor={A('start')}>{(T as any).labels[1]}</text>
        <text x="300" y="58" text-anchor={A('middle')}>{(T as any).labels[2]}</text>
        <text x="435" y="200" text-anchor={A('middle')}>{(T as any).labels[3]}</text>
        <text x="560" y="200" text-anchor={A('end')}>{(T as any).labels[4]}</text>
        <text x="330" y="208" text-anchor={A('end')}>{(T as any).labels[5]}</text>
      </g>
      <line x1="503" y1="152" x2="540" y2="182" class="ill-lead" />
      <line x1="80" y1="136" x2="120" y2="148" class="ill-lead" />
    </svg>
  )}

  {name === 'surgical' && (
    <svg viewBox="0 0 560 300" role="img" aria-labelledby={`ill-${name}-${lang}`}>
      <title id={`ill-${name}-${lang}`}>{(T as any).caption}</title>
      <rect x="20" y="40" width="520" height="220" rx="24" class="ill-skin-flat" />
      <ellipse cx="280" cy="150" rx="210" ry="80" class="ill-warn-halo" />
      <ellipse cx="280" cy="150" rx="150" ry="26" class="ill-mild" />
      <line x1="150" y1="150" x2="410" y2="150" class="ill-incision" />
      {Array.from({ length: 9 }, (_, i) => <line x1={166 + i * 29} y1="136" x2={166 + i * 29} y2="164" class="ill-stitch" />)}
      <g class="ill-label">
        <text x="280" y="112" text-anchor={A('middle')}>{(T as any).labels[0]}</text>
        <text x="280" y="204" text-anchor={A('middle')}>{(T as any).labels[1]}</text>
        <text x="280" y="250" text-anchor={A('middle')} class="ill-label-warn">{(T as any).labels[2]}</text>
      </g>
    </svg>
  )}
  <figcaption>{(T as any).caption}</figcaption>
</figure>
