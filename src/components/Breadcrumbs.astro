---
import type { Lang } from '../config/site';
import { path, pages, parentOf, type PageKey } from '../lib/routes';
interface Props { lang: Lang; pageKey?: PageKey; trail?: Array<{ name: string; path: string }> }
const { lang, pageKey, trail } = Astro.props;
const parent = pageKey ? parentOf(pageKey) : undefined;
const items = trail ?? [
  { name: pages.home.nav[lang], path: path(lang, 'home') },
  ...(parent ? [{ name: pages[parent].nav[lang], path: path(lang, parent) }] : []),
  { name: pages[pageKey!].nav[lang], path: path(lang, pageKey!) },
];
---
<nav class="breadcrumbs" aria-label={lang === 'ar' ? 'مسار التنقل' : 'Breadcrumb'}>
  <ol>
    {items.map((it, i) => (
      <li><a href={it.path} aria-current={i === items.length - 1 ? 'page' : undefined}>{it.name}</a></li>
    ))}
  </ol>
</nav>
