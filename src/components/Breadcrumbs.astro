---
import type { Lang } from '../config/site';
import { path, pages, type PageKey } from '../lib/routes';
interface Props { lang: Lang; pageKey: PageKey }
const { lang, pageKey } = Astro.props;
---
<nav class="breadcrumbs" aria-label={lang === 'ar' ? 'مسار التنقل' : 'Breadcrumb'}>
  <ol>
    <li><a href={path(lang, 'home')}>{pages.home.nav[lang]}</a></li>
    <li><a href={path(lang, pageKey)} aria-current="page">{pages[pageKey].nav[lang]}</a></li>
  </ol>
</nav>
