---
/**
 * Contact links as small 3D icon tiles (Aissar, item 13, 24 Nov 2026): each link is its own drawn logo
 * (WhatsApp, phone, email, LinkedIn, Instagram, Facebook) that can be clicked. The depth is pure CSS
 * (gradient face, gloss, a darker "edge" underneath and a soft shadow); with a mouse the tile also tilts
 * towards the pointer. Data: src/config/site.ts (contact + verified, visible profiles only).
 */
import { contact, profiles, type Lang } from '../config/site';
import { t } from '../lib/i18n';
import { whatsappUrl, telUrl, mailtoUrl, track } from '../lib/links';
interface Props { lang: Lang; page: string; placement?: string }
const { lang, page, placement = 'footer' } = Astro.props;
const s = t(lang);
const ref = { lang, page, placement };
const ar = lang === 'ar';
type Item = { id: string; label: string; detail?: string; href: string; attrs: Record<string, string> };
const items: Item[] = [
  { id: 'whatsapp', label: 'WhatsApp', href: whatsappUrl(ref), attrs: { rel: 'noopener', ...track('whatsapp_click', ref) } },
  { id: 'phone', label: ar ? 'اتصال' : 'Call', detail: contact.phoneDisplay, href: telUrl(), attrs: track('phone_click', ref) },
  { id: 'email', label: ar ? 'البريد الإلكتروني' : 'Email', detail: contact.email, href: mailtoUrl(ref), attrs: track('email_click', ref) },
  ...profiles
    .filter((p) => p.verified && !('schemaOnly' in p && p.schemaOnly))
    .map((p) => ({ id: p.id, label: p.label, href: p.url, attrs: { rel: 'noopener me', ...track('outbound_profile', { ...ref, placement: `${placement}-${p.id}` }) } })),
];
---
<div class="contact3d">
  <h2 class="visually-hidden">{s.contactTitle}</h2>
  <ul class="c3d-list" role="list">
    {items.map((it) => (
      <li>
        <a class={`c3d c3d-${it.id}`} href={it.href} {...it.attrs} aria-label={it.detail ? `${it.label}: ${it.detail}` : it.label}>
          <span class="c3d-face" aria-hidden="true">
            {it.id === 'whatsapp' && <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>}
            {it.id === 'phone' && <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>}
            {it.id === 'email' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.8 7 8.2 6.2L20.2 7"/></svg>}
            {it.id === 'linkedin' && <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2ZM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2Zm1.8 13.1H3.6V9h3.5v11.5Z"/></svg>}
            {it.id === 'instagram' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" stroke="none"/></svg>}
            {it.id === 'facebook' && <svg viewBox="0 0 24 24"><path fill="currentColor" d="M13.6 21.5v-8h2.7l.4-3.2h-3.1V8.3c0-.9.3-1.5 1.6-1.5h1.6V3.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.4H7.7v3.2h2.7v8h3.2Z"/></svg>}
          </span>
          <span class="c3d-tip" aria-hidden="true">{it.label}{it.detail && <bdi dir="ltr">{it.detail}</bdi>}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
<script>
  /* With a mouse, each tile tilts towards the pointer (skipped for reduced motion and touch). */
  if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.c3d').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.setProperty('--ry', `${(x * 28).toFixed(1)}deg`);
        el.style.setProperty('--rx', `${(-y * 28).toFixed(1)}deg`);
        el.style.setProperty('--gx', `${((x + 0.5) * 100).toFixed(0)}%`);
      });
      el.addEventListener('pointerleave', () => { el.style.removeProperty('--rx'); el.style.removeProperty('--ry'); el.style.removeProperty('--gx'); });
    });
  }
</script>
