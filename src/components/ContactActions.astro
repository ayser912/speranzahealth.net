---
import type { Lang } from '../config/site';
import { t } from '../lib/i18n';
import { whatsappUrl, telUrl, mailtoUrl, track } from '../lib/links';
import Icon from './Icon.astro';
interface Props { lang: Lang; page: string; placement: string; show?: Array<'whatsapp' | 'call' | 'email'> }
const { lang, page, placement, show = ['whatsapp', 'call', 'email'] } = Astro.props;
const s = t(lang);
const ref = { lang, page, placement };
---
<div class="actions">
  {show.includes('whatsapp') && <a class="btn btn-primary" href={whatsappUrl(ref)} rel="noopener" {...track('whatsapp_click', ref)}><Icon name="whatsapp" />{s.whatsapp}</a>}
  {show.includes('call') && <a class="btn btn-secondary" href={telUrl()} {...track('phone_click', ref)}><Icon name="phone" />{s.call}</a>}
  {show.includes('email') && <a class="btn btn-secondary" href={mailtoUrl(ref)} {...track('email_click', ref)}><Icon name="mail" />{s.email}</a>}
</div>
