---
/** The site's signature element: the CWS® credential presented as a verifiable record. */
import { person, credentials, type Lang } from '../config/site';
import { path } from '../lib/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cws = credentials.find((c) => c.id === 'cws')!;
const bsn = credentials.find((c) => c.id === 'bsn')!;
const L = lang === 'ar'
  ? { sub: 'سجل الاعتماد المهني', holder: 'الاسم', cred: 'الاعتماد', issuer: 'الجهة المانحة', year: 'سنة الاعتماد', degree: 'الشهادة الجامعية', verify: 'تحقق من الاعتماد في الدليل الرسمي', all: 'كل المؤهلات' }
  : { sub: 'Professional credential record', holder: 'Holder', cred: 'Credential', issuer: 'Issued by', year: 'Certified', degree: 'Degree', verify: 'Verify in the official directory', all: 'All credentials' };
---
<section class="record" aria-labelledby="record-h">
  <div class="record-head">
    <span class="record-mark" aria-hidden="true">CWS®</span>
    <h2 id="record-h" class="record-sub" style="margin:0;font-size:inherit;font-weight:400">{L.sub}</h2>
  </div>
  <dl>
    <dt>{L.holder}</dt><dd>{person.name[lang]}</dd>
    <dt>{L.cred}</dt><dd>{cws.name[lang]}</dd>
    <dt>{L.issuer}</dt><dd lang="en">{cws.issuer.en}</dd>
    <dt>{L.year}</dt><dd>{cws.year}</dd>
    <dt>{L.degree}</dt><dd>{bsn.name[lang]}{lang === 'ar' ? '، ' : ', '}{bsn.issuer[lang]} ({bsn.year})</dd>
  </dl>
  <p class="record-verify">
    <a href={cws.verifyUrl} rel="noopener">{L.verify}</a>
    <a href={path(lang, 'credentials')}>{L.all}</a>
  </p>
</section>
