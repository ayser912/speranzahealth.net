---
/**
 * Search box in the header of every page (added 11 Nov 2026). Without JavaScript it is a plain form
 * that opens the search page; with JavaScript it shows live results under the box as you type.
 * On phones it collapses behind a search button.
 */
import type { Lang } from '../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = lang === 'ar'
  ? { label: 'البحث في الموقع', ph: 'ابحث: كلمة، جملة، رقم، اسم…', go: 'بحث', open: 'فتح البحث', all: 'عرض كل النتائج', none: 'لا توجد نتائج مطابقة.', loading: 'جارٍ البحث…' }
  : { label: 'Search the site', ph: 'Search: word, phrase, number, name…', go: 'Search', open: 'Open search', all: 'See all results', none: 'No matching results.', loading: 'Searching…' };
---
<div class="site-search" data-lang={lang} data-all={L.all} data-none={L.none} data-loading={L.loading}>
  <button type="button" class="search-toggle" aria-expanded="false" aria-controls="site-search-form" aria-label={L.open}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  </button>
  <form id="site-search-form" class="search-form" role="search" action={`/${lang}/search/`} method="get" aria-label={L.label}>
    <label class="visually-hidden" for="site-search-q">{L.label}</label>
    <input id="site-search-q" type="search" name="q" placeholder={L.ph} autocomplete="off" enterkeyhint="search"
      role="combobox" aria-expanded="false" aria-controls="site-search-results" aria-autocomplete="list" />
    <button type="submit" class="search-go" aria-label={L.go}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <div id="site-search-results" class="search-pop" hidden></div>
  </form>
</div>
<script>
  import { loadIndex, search, resultHtml } from '../lib/search-client';
  const root = document.querySelector<HTMLElement>('.site-search');
  if (root) {
    const lang = root.dataset.lang!;
    const input = root.querySelector<HTMLInputElement>('input[name="q"]')!;
    const pop = root.querySelector<HTMLElement>('.search-pop')!;
    const toggle = root.querySelector<HTMLButtonElement>('.search-toggle')!;
    const setOpen = (open: boolean) => { pop.hidden = !open; input.setAttribute('aria-expanded', String(open)); };
    let timer = 0;
    const run = async () => {
      const q = input.value.trim();
      if (q.length < 2) { setOpen(false); return; }
      pop.innerHTML = `<p class="sp-note">${root.dataset.loading}</p>`; setOpen(true);
      const hits = search(await loadIndex(lang), q, 6);
      if (input.value.trim() !== q) return;
      const all = `<a class="sp-all" href="/${lang}/search/?q=${encodeURIComponent(q)}">${root.dataset.all} <span aria-hidden="true">${lang === 'ar' ? '←' : '→'}</span></a>`;
      pop.innerHTML = hits.length
        ? `<ul role="list">${hits.map((h) => `<li>${resultHtml(h)}</li>`).join('')}</ul>${all}`
        : `<p class="sp-note">${root.dataset.none}</p>`;
    };
    input.addEventListener('focus', () => { loadIndex(lang); });
    input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 160); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && !pop.hidden) { e.preventDefault(); pop.querySelector<HTMLAnchorElement>('a')?.focus(); }
      if (e.key === 'Escape') { setOpen(false); }
    });
    pop.addEventListener('keydown', (e) => {
      const links = [...pop.querySelectorAll<HTMLAnchorElement>('a')];
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') { e.preventDefault(); links[Math.min(i + 1, links.length - 1)]?.focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); (i <= 0 ? input : links[i - 1]).focus(); }
      if (e.key === 'Escape') { setOpen(false); input.focus(); }
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) setOpen(false); });
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      root.classList.toggle('open', open);
      if (open) input.focus();
    });
  }
</script>
