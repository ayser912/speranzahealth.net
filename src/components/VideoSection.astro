---
/**
 * Video area for a page. Shows the page's videos from config (`videos`), embedding YouTube with the
 * privacy-friendly player and linking Instagram reels. With no videos yet, it links to the Instagram profile.
 */
import { videos, profiles, type Lang } from '../config/site';
import VideoEmbed from './VideoEmbed.astro';
import { track } from '../lib/links';
interface Props { lang: Lang; page: string }
const { lang, page } = Astro.props;
const list = videos.filter((v) => v.page === page);
const ig = profiles.find((p) => p.id === 'instagram');
const yt = profiles.find((p) => p.id === 'youtube');
const channel = yt?.verified ? yt : ig;
const L = lang === 'ar'
  ? { h: 'فيديوهات تعليمية', more: 'شاهد الفيديوهات التعليمية', sub: 'شروحات قصيرة بالعربية عن العناية بالجروح على', reel: 'شاهد على Instagram' }
  : { h: 'Educational videos', more: 'Watch the educational videos', sub: 'Short wound-care explainers on', reel: 'Watch on Instagram' };
---
<section class="videos" aria-labelledby={`vid-h-${page}`}>
  <h2 id={`vid-h-${page}`}>{L.h}</h2>
  {list.map((v) =>
    v.platform === 'youtube' ? (
      <VideoEmbed lang={lang} video={{ youtubeId: v.ref, title: v.title, description: v.title, uploadDate: v.uploadDate ?? '', duration: v.duration ?? '' }} />
    ) : (
      <p><a href={v.ref} rel="noopener" {...track('outbound_profile', { lang, page, placement: `video-${v.id}` })}>{v.title[lang]} ({L.reel})</a></p>
    ),
  )}
  {channel && (
    <a class="video-cta" href={channel.url} rel="noopener" {...track('outbound_profile', { lang, page, placement: 'video-channel' })}>
      <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
      <span><strong>{L.more}</strong><span>{L.sub} {channel.label}</span></span>
    </a>
  )}
</section>
