---
/**
 * Homepage video area: the newest awareness videos and a link to the full library (the Videos page in the
 * main menu, added 23 Nov 2026). Data: src/content/videos.ts.
 */
import { profiles, type Lang } from '../config/site';
import { path } from '../lib/routes';
import { track } from '../lib/links';
import { videos, videoUrl, patientTopics } from '../content/videos';
import TopicIcon from './TopicIcon.astro';
interface Props { lang: Lang; page: string }
const { lang, page } = Astro.props;
const latest = videos.filter((v) => v.audience === 'patients').slice(0, 4);
const topicName = (id: string) => patientTopics.find((t) => t.id === id)?.title[lang] ?? '';
const ig = profiles.find((p) => p.id === 'instagram');
const L = lang === 'ar'
  ? { h: 'فيديوهات تثقيفية', p: 'فيديوهات قصيرة بالعربية عن العناية بالجروح، مقسّمة حسب الموضوع مع خانة بحث.', all: 'كل الفيديوهات التثقيفية', sub: 'مقسّمة حسب الموضوع', follow: 'تابعنا على Instagram', newTab: '(يفتح في نافذة جديدة)' }
  : { h: 'Health awareness videos', p: 'Short wound-care videos in Arabic, sorted by topic, with a search box.', all: 'All awareness videos', sub: 'sorted by topic', follow: 'Follow us on Instagram', newTab: '(opens in a new tab)' };
---
<section class="videos" aria-labelledby={`vid-h-${page}`}>
  <h2 id={`vid-h-${page}`}>{L.h}</h2>
  <p>{L.p}</p>
  <ul class="video-teaser" role="list">
    {latest.map((v) => (
      <li><a href={videoUrl(v)} target="_blank" rel="noopener" {...track('outbound_profile', { lang, page, placement: `video-${v.code}` })}>
        <span class="vlib-dot" aria-hidden="true"><TopicIcon name="play" /></span>
        <span>{v.title[lang]}<small>{topicName(v.topic)}</small><span class="visually-hidden"> {L.newTab}</span></span>
      </a></li>
    ))}
  </ul>
  <a class="video-cta" href={path(lang, 'videos')} {...track('cta_click', { lang, page, placement: 'video-library' })}>
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
    <span><strong>{L.all}</strong><span>{L.sub}</span></span>
  </a>
  {ig && <p class="muted"><a href={ig.url} rel="noopener" {...track('outbound_profile', { lang, page, placement: 'video-channel' })}>{L.follow}</a></p>}
</section>
