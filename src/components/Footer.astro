---
/**
 * Footer (redesigned 24 Nov 2026, Aissar items 11–14):
 * - brand + short description (no founder line, no emergency line — the emergency strip stays at the top of every page);
 * - one bar with three menus («العناية بالجروح», «للكوادر الصحية», «روابط»): each opens when the mouse points at it
 *   (or on click / tap / keyboard) and the visitor picks a link;
 * - under the bar, the contact links as small 3D icons (ContactIcons).
 * Without JavaScript the three lists are simply shown open.
 */
import { site, type Lang } from '../config/site';
import { path, footerNav, careNav, careLabel, proNav, proLabel, pages, isPublic, type PageKey } from '../lib/routes';
import { t } from '../lib/i18n';
import ContactIcons from './ContactIcons.astro';
interface Props { lang: Lang; pageKey?: PageKey }
const { lang, pageKey } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
const link = (k: PageKey) => ({ href: path(lang, k), label: pages[k].nav[lang], current: k === pageKey });
const menus = [
  { id: 'care', label: careLabel[lang], links: [{ ...link('articles'), label: lang === 'ar' ? 'كل الأدلة والمقالات' : 'All guides and articles' }, ...careNav.map(link)] },
  { id: 'pros', label: proLabel[lang], links: proNav.filter(isPublic).map(link) },
  { id: 'links', label: lang === 'ar' ? 'روابط' : 'Links', links: footerNav.filter(isPublic).map(link) },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-about">
      <h2 class="footer-brand"><img src={site.logo.mark} width="40" height="40" alt="" loading="lazy" decoding="async" />{site.siteName[lang]}</h2>
      <p>{s.footerAbout}</p>
    </div>
    <nav class="footer-bar" aria-label={lang === 'ar' ? 'روابط الموقع' : 'Site links'}>
      {menus.map((m) => (
        <div class="fmenu">
          <button type="button" class="fmenu-toggle" aria-expanded="false" aria-controls={`fm-${m.id}`}>
            <span>{m.label}</span><svg aria-hidden="true" viewBox="0 0 12 12" width="12" height="12"><path d="M2 8l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
          <ul id={`fm-${m.id}`} class="fmenu-list">
            {m.links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <ContactIcons lang={lang} page={pageKey ?? 'other'} />
    <div class="footer-legal">
      <p>© {year} {site.siteName[lang]} · {site.domain}. {s.rights}.</p>
    </div>
  </div>
</footer>
<script>
  /* Footer menus: open on mouse hover (with a short grace period when leaving), click/tap and keyboard. */
  const menus = [...document.querySelectorAll<HTMLElement>('.fmenu')];
  const toggleOf = (m: HTMLElement) => m.querySelector<HTMLButtonElement>('.fmenu-toggle')!;
  const setOpen = (m: HTMLElement, open: boolean) => { m.classList.toggle('open', open); toggleOf(m).setAttribute('aria-expanded', String(open)); };
  const closeOthers = (keep?: HTMLElement) => menus.forEach((m) => { if (m !== keep) setOpen(m, false); });
  menus.forEach((m) => {
    let timer = 0;
    const btn = toggleOf(m);
    btn.addEventListener('click', () => { const open = !m.classList.contains('open'); closeOthers(m); setOpen(m, open); });
    m.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'mouse') return; clearTimeout(timer); closeOthers(m); setOpen(m, true); });
    m.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'mouse') return; timer = window.setTimeout(() => setOpen(m, false), 220); });
    m.addEventListener('focusout', (e) => { if (!m.contains(e.relatedTarget as Node)) setOpen(m, false); });
    m.addEventListener('keydown', (e) => { if (e.key === 'Escape' && m.classList.contains('open')) { setOpen(m, false); btn.focus(); } });
  });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest?.('.fmenu')) closeOthers(); });
</script>
