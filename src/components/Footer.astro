---
import { person, contact, profiles, site, type Lang } from '../config/site';
import { path, footerNav, careNav, careLabel, pages, type PageKey } from '../lib/routes';
import { t } from '../lib/i18n';
import { whatsappUrl, telUrl, mailtoUrl, track } from '../lib/links';
interface Props { lang: Lang; pageKey?: PageKey }
const { lang, pageKey } = Astro.props;
const s = t(lang);
const ref = { lang, page: pageKey ?? 'other', placement: 'footer' };
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h2 class="footer-brand"><img src={site.logo.mark} width="40" height="40" alt="" loading="lazy" decoding="async" />{site.siteName[lang]}</h2>
        <p>{lang === 'ar' ? 'المؤسس: ' : 'Founder: '}<a href={path(lang, 'about')}>{person.name[lang]}</a>{lang === 'ar' ? '، ' : ', '}<span class="ltr">{person.postNominals}</span></p>
        <p>{s.footerAbout}</p>
        <p><strong>{s.emergencyShort}</strong></p>
      </div>
      <div>
        <h2>{careLabel[lang]}</h2>
        <ul>
          <li><a href={path(lang, 'articles')}>{lang === 'ar' ? 'كل الأدلة والمقالات' : 'All guides and articles'}</a></li>
          {careNav.map((k) => <li><a href={path(lang, k)}>{pages[k].nav[lang]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{lang === 'ar' ? 'روابط' : 'Links'}</h2>
        <ul>
          {footerNav.map((k) => <li><a href={path(lang, k)}>{pages[k].nav[lang]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{s.contactTitle}</h2>
        <ul>
          <li><a href={whatsappUrl(ref)} {...track('whatsapp_click', ref)} rel="noopener">WhatsApp</a></li>
          <li><a href={telUrl()} {...track('phone_click', ref)}><span class="ltr">{contact.phoneDisplay}</span></a></li>
          <li><a href={mailtoUrl(ref)} {...track('email_click', ref)}><span class="ltr">{contact.email}</span></a></li>
          {profiles.filter((p) => p.verified && !('schemaOnly' in p && p.schemaOnly)).map((p) => (
            <li><a href={p.url} rel="noopener me" {...track('outbound_profile', { ...ref, placement: `footer-${p.id}` })}>{p.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <p>© {year} {site.siteName[lang]} · {site.domain}. {s.rights}.</p>
    </div>
  </div>
</footer>
