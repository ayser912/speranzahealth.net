---
/**
 * Generic, original illustrations of each dressing category (added 11 Nov 2026 at Aissar's request:
 * "pictures of each modern dressing type, in general, not specific brands"). Simple cross-sections:
 * skin band at the bottom with a wound bed, the dressing drawn on top. Compression items show a lower leg.
 * Never draw a product's shape, colour scheme or logo.
 */
import type { Lang } from '../config/site';
interface Props { id: string; label: string; lang: Lang }
const { id, label, lang } = Astro.props;
const alt = lang === 'ar' ? `رسم توضيحي عام: ${label}` : `Generic illustration: ${label}`;

const C = { skin: '#efd6c4', skinLine: '#d9b49c', fat: '#f7e9c8', bed: '#c96f63', bedDeep: '#a9524a', ink: '#10302a', teal: '#0a5c47', gold: '#c9a35f', white: '#ffffff', grey: '#9aa7a2' };
const leg = ['short-stretch', 'long-stretch', 'multilayer', 'stockings', 'wraps', 'ipc'].includes(id);
const ostomy = ['one-piece', 'two-piece', 'closed-bag', 'drainable-bag', 'convex', 'stoma-accessories', 'irrigation'].includes(id);
const onSkin = ['one-piece', 'two-piece', 'closed-bag', 'drainable-bag'].includes(id);
/** Generic ostomy-bag outline (rounded pouch). */
const bag = (x: number, y: number, w: number, h: number) => `M${x} ${y + 18} Q${x} ${y} ${x + 18} ${y} H${x + w - 18} Q${x + w} ${y} ${x + w} ${y + 18} V${y + h * 0.62} Q${x + w} ${y + h} ${x + w / 2} ${y + h} Q${x} ${y + h} ${x} ${y + h * 0.62} Z`;
const dots = (n: number, x0: number, x1: number, y0: number, y1: number, seed = 7) => {
  const out: Array<[number, number]> = []; let s = seed;
  for (let i = 0; i < n; i++) { s = (s * 9301 + 49297) % 233280; const a = s / 233280; s = (s * 9301 + 49297) % 233280; const b = s / 233280; out.push([x0 + a * (x1 - x0), y0 + b * (y1 - y0)]); }
  return out;
};
---
<svg class="dc-art" viewBox="0 0 320 180" role="img" aria-label={alt} xmlns="http://www.w3.org/2000/svg">
  {ostomy && <rect x="0" y="0" width="320" height="180" fill={onSkin ? C.skin : '#e5efe9'} />}
  {id === 'one-piece' && (
    <g>
      <path d={bag(100, 24, 120, 146)} fill="#f4ead8" stroke="#c9b48f" stroke-width="2" />
      <circle cx="160" cy="62" r="30" fill={C.white} stroke={C.grey} stroke-width="2" />
      <circle cx="160" cy="62" r="13" fill={C.bed} />
      <circle cx="200" cy="36" r="5" fill="#3a3f3d" />
    </g>
  )}
  {id === 'two-piece' && (
    <g>
      <circle cx="90" cy="90" r="44" fill={C.white} stroke={C.grey} stroke-width="2" />
      <circle cx="90" cy="90" r="26" fill="none" stroke={C.teal} stroke-width="5" />
      <circle cx="90" cy="90" r="13" fill={C.bed} />
      <path d={bag(190, 24, 110, 146)} fill="#f4ead8" stroke="#c9b48f" stroke-width="2" />
      <circle cx="245" cy="62" r="26" fill="none" stroke={C.teal} stroke-width="5" />
      <path d="M142 90 H182 M170 80 l12 10 -12 10" fill="none" stroke={C.teal} stroke-width="3" stroke-linecap="round" />
    </g>
  )}
  {id === 'closed-bag' && (
    <g>
      <path d={bag(100, 18, 120, 152)} fill="#f4ead8" stroke="#c9b48f" stroke-width="2" />
      <circle cx="160" cy="56" r="22" fill={C.white} stroke={C.grey} stroke-width="2" />
      <circle cx="198" cy="34" r="7" fill="#3a3f3d" />
      <path d="M222 36 q6 -8 0 -16 M236 36 q6 -8 0 -16 M250 36 q6 -8 0 -16" fill="none" stroke={C.grey} stroke-width="2.5" stroke-linecap="round" />
    </g>
  )}
  {id === 'drainable-bag' && (
    <g>
      <path d="M100 36 Q100 18 118 18 H202 Q220 18 220 36 V112 Q220 132 196 146 L182 160 H138 L124 146 Q100 132 100 112 Z" fill="#f4ead8" stroke="#c9b48f" stroke-width="2" />
      <circle cx="160" cy="56" r="22" fill={C.white} stroke={C.grey} stroke-width="2" />
      <rect x="130" y="158" width="60" height="12" rx="4" fill={C.teal} />
    </g>
  )}
  {id === 'convex' && (
    <g>
      <path d="M10 120 H70 Q80 120 82 110 Q86 96 92 110 Q94 120 104 120 H150" fill="none" stroke={C.skinLine} stroke-width="3" />
      <rect x="10" y="104" width="62" height="10" rx="3" fill={C.white} stroke={C.grey} stroke-width="1.5" />
      <rect x="106" y="104" width="44" height="10" rx="3" fill={C.white} stroke={C.grey} stroke-width="1.5" />
