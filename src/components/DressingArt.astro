      <path d="M172 80 q-6 10 0 16 q6 -6 0 -16 Z" fill="#7cc3dd" />
    </g>
  )}
  {id === 'collagen' && (
    <g>
      <rect x="84" y="82" width="152" height="22" rx="4" fill="#f5efe4" stroke="#c9b48f" stroke-width="2" />
