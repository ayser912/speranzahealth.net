      {id === 'ipc' && (
        <g>
          <path d="M120 16 L190 16 L188 140 L124 140 Z" fill="#dbe8f0" stroke="#7aa6bd" stroke-width="2" />
          {[0, 1, 2, 3].map((i) => <line x1="122" y1={`${46 + i * 26}`} x2="189" y2={`${46 + i * 26}`} stroke="#7aa6bd" stroke-width="2" />)}
