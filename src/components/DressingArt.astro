      {[0, 1, 2].map((i) => <path d={`M${120 + i * 40} 52 q-8 -12 0 -22 q8 -10 0 -22`} fill="none" stroke={C.grey} stroke-width="3" stroke-linecap="round" opacity="0.7" />)}
    </g>
  )}
  {id === 'skin-substitutes' && (
    <g>
      <path d="M100 104 Q110 128 160 130 Q210 128 220 104 Z" fill="#f2c6b4" stroke="#d99f88" stroke-width="2" />
      {dots(28, 116, 204, 106, 124, 5).map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="#d98d74" />)}
