  {leg && (
    <g>
      <path d="M128 6 C126 50 124 92 130 120 C134 140 128 150 126 160 L200 166 C214 168 222 160 214 154 C196 150 182 146 178 132 C176 104 182 52 184 6 Z" fill={C.skin} stroke={C.skinLine} stroke-width="2" />
      {id === 'short-stretch' && [0, 1, 2, 3, 4, 5].map((i) => <path d={`M124 ${28 + i * 22} L186 ${16 + i * 22} L186 ${32 + i * 22} L124 ${44 + i * 22} Z`} fill="#e6c79a" stroke="#b9925a" stroke-width="1.5" />)}
