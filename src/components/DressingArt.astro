      {dots(46, 70, 250, 65, 89, 21).map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="#8cc4d8" />)}
    </g>
  )}
  {id === 'film' && (
    <g>
      <path d="M40 103 H280" stroke={C.teal} stroke-width="3" opacity="0.6" />
      <path d="M40 99 H280" stroke={C.teal} stroke-width="1" stroke-dasharray="6 6" opacity="0.6" />
