          {[0, 1, 2, 3, 4].map((i) => <path d={`M124 ${30 + i * 22} L186 ${18 + i * 22} L186 ${30 + i * 22} L124 ${42 + i * 22} Z`} fill="#e6c79a" opacity="0.9" />)}
          {[0, 1, 2, 3, 4].map((i) => <path d={`M124 ${40 + i * 22} L186 ${28 + i * 22} L186 ${34 + i * 22} L124 ${46 + i * 22} Z`} fill={C.teal} opacity="0.55" />)}
        </g>
      )}
      {id === 'stockings' && (
        <g>
          <path d="M126 14 C125 52 124 92 130 120 C134 140 128 150 126 160 L198 164 C206 162 206 156 198 154 C190 150 180 146 178 132 C176 104 180 52 182 14 Z" fill="#c8b39a" opacity="0.92" />
          <path d="M126 14 H182" stroke="#a48d72" stroke-width="5" />
