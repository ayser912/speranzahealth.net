      <path d="M170 120 H218 Q226 128 232 112 Q236 92 242 112 Q248 128 256 120 H310" fill="none" stroke={C.skinLine} stroke-width="3" />
      <path d="M170 106 H214 Q224 118 230 104" fill="none" stroke={C.teal} stroke-width="6" stroke-linecap="round" />
      <path d="M254 104 Q260 118 270 106 H310" fill="none" stroke={C.teal} stroke-width="6" stroke-linecap="round" />
      <circle cx="237" cy="88" r="8" fill={C.bed} />
    </g>
  )}
  {id === 'stoma-accessories' && (
    <g>
      <circle cx="70" cy="90" r="34" fill="#e8c99a" />
      <circle cx="70" cy="90" r="15" fill="#e5efe9" />
      <rect x="128" y="52" width="40" height="86" rx="8" fill={C.white} stroke={C.grey} stroke-width="2" />
      <rect x="138" y="40" width="20" height="14" rx="3" fill={C.teal} />
      <rect x="190" y="74" width="120" height="30" rx="8" fill="#d9e6e1" stroke={C.teal} stroke-width="2" />
      <rect x="236" y="70" width="28" height="38" rx="6" fill={C.white} stroke={C.teal} stroke-width="2" />
    </g>
  )}
  {id === 'irrigation' && (
    <g>
      <path d="M40 14 H100 V70 Q100 86 70 86 Q40 86 40 70 Z" fill="#cfe6ee" stroke="#7aa6bd" stroke-width="2" />
      <path d="M70 86 C70 130 130 130 150 110" fill="none" stroke="#7aa6bd" stroke-width="4" />
      <path d="M150 104 l16 6 -16 6 Z" fill={C.teal} />
      <path d="M178 70 h40 v90 h-40 Z" fill="#f4ead8" stroke="#c9b48f" stroke-width="2" />
      <circle cx="270" cy="70" r="24" fill={C.white} stroke={C.grey} stroke-width="2" />
      <circle cx="270" cy="70" r="10" fill="#f4ead8" />
    </g>
  )}

  {!leg && !ostomy && (
    <g>
      <rect x="0" y="118" width="320" height="62" fill={C.fat} />
      <rect x="0" y="104" width="320" height="16" fill={C.skin} />
      <line x1="0" y1="104" x2="320" y2="104" stroke={C.skinLine} stroke-width="2" />
      <path d="M100 104 Q110 140 160 142 Q210 140 220 104 Z" fill={C.bed} />
      <path d="M120 112 Q160 134 200 112" fill="none" stroke={C.bedDeep} stroke-width="2" opacity="0.5" />
    </g>
  )}

  {id === 'antimicrobial' && (
    <g>
      <rect x="70" y="80" width="180" height="24" rx="6" fill={C.white} stroke={C.grey} stroke-width="2" />
      {dots(34, 78, 242, 85, 100).map(([x, y]) => <circle cx={x} cy={y} r="2.4" fill="#8f9aa0" />)}
      <text x="160" y="58" text-anchor="middle" font-family="Inter, sans-serif" font-size="20" font-weight="700" fill={C.teal}>Ag</text>
    </g>
  )}
  {id === 'alginate' && (
    <g>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M${104 + i * 16} 104 q8 -40 0 -70 q-8 -20 6 -26`} fill="none" stroke={C.gold} stroke-width="5" stroke-linecap="round" opacity="0.9" />)}
      <path d="M104 106 Q112 136 160 138 Q208 136 216 106 Z" fill={C.gold} opacity="0.55" />
    </g>
  )}
  {id === 'hydrocolloid' && (
    <g>
      <path d="M50 104 L80 74 H240 L270 104 Z" fill="#e8c99a" stroke="#b9925a" stroke-width="2" />
      <rect x="80" y="70" width="160" height="5" rx="2" fill="#d2ad76" />
      {dots(10, 95, 225, 82, 98, 3).map(([x, y]) => <ellipse cx={x} cy={y} rx="6" ry="3" fill="#f3dfbc" />)}
    </g>
  )}
  {id === 'foam' && (
    <g>
      <rect x="64" y="58" width="192" height="46" rx="10" fill="#fdf7e8" stroke={C.gold} stroke-width="2" />
      {dots(40, 72, 248, 62, 100, 11).map(([x, y], i) => <circle cx={x} cy={y} r={2 + (i % 3)} fill="none" stroke={C.gold} stroke-width="1.5" />)}
      <rect x="64" y="58" width="192" height="8" rx="4" fill={C.teal} opacity="0.85" />
    </g>
  )}
  {id === 'hydrogel' && (
    <g>
      <path d="M104 106 Q112 136 160 138 Q208 136 216 106 Z" fill="#9fd3e6" opacity="0.8" />
      <rect x="196" y="20" width="80" height="30" rx="8" fill={C.white} stroke={C.grey} stroke-width="2" transform="rotate(28 236 35)" />
