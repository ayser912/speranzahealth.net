---
import type { Lang } from '../config/site';
import { t } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<aside class="emergency" aria-label={lang === 'ar' ? 'تنبيه الحالات الطارئة' : 'Emergency notice'}>
  <div class="wrap"><p>{t(lang).emergency}</p></div>
</aside>
