---
/** Compact author line required on every clinical page: name, credentials, link to verification, review date. */
import { person, type Lang } from '../config/site';
import { path, credentialsHref } from '../lib/routes';
import { t, formatDate } from '../lib/i18n';
interface Props { lang: Lang; published: string; reviewed: string; medicalReviewer?: { name: string; title: string } | null }
const { lang, reviewed, medicalReviewer = null } = Astro.props;
const s = t(lang);
---
<p class="byline">
  <span>{s.authorBy}: <a href={path(lang, 'about')}>{person.name[lang]}</a>{lang === 'ar' ? '، ' : ', '}<span class="ltr">{person.postNominals}</span></span>
  <span>{s.reviewed}: <time datetime={reviewed}>{formatDate(reviewed, lang)}</time></span>
  {medicalReviewer && <span>{lang === 'ar' ? 'المراجعة الطبية' : 'Medical review'}: {medicalReviewer.name}, {medicalReviewer.title}</span>}
  <a href={credentialsHref(lang)}>{s.credentialsCta}</a>
</p>
