# Copy to .env and fill in. Never commit .env.
# Public production URL (no trailing slash)
SITE_URL=https://speranzahealth.net
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable analytics)
PUBLIC_GA4_ID=
# Google Search Console HTML-tag verification token (content="..." value only)
PUBLIC_GSC_VERIFICATION=
